{
  "_comment": "Sukhi Play itself is an Electron desktop app: `npm run dev` opens a window and never listens on a port, so there is nothing for a browser preview to attach to. Run it with `npm run dev` in a terminal. The only thing here a browser can show is the website in docs/.",
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "docs"
      ],
      "port": 8765
    },
    {
      "name": "colouring",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "vite",
        "--port",
        "5177",
        "--strictPort"
      ],
      "port": 5177,
      "cwd": "playground/colouring"
    },
    {
      "name": "studio",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "vite",
        "--port",
        "5178",
        "--strictPort"
      ],
      "port": 5178,
      "cwd": "playground/studio"
    }
  ]
}
