---
/**
 * The catalogue, built from config/suggestions.json — the same file the app
 * ships and reads. Two copies of a list drift, and the one that drifts is
 * always the one somebody is reading.
 *
 * What this page deliberately does not do: no third-party logos or favicons,
 * no "recommended" or "safe", no analytics, no embeds, and no fonts or images
 * from anywhere else. It is a compatibility list, which is what the data
 * actually is: the hosts each site needs before it will work.
 */
import Base from '../layouts/Base.astro';
import { SHAPES } from '../shapes';
import { REPO } from '../site';
import data from '../../../config/suggestions.json';
import bundledData from '../../../config/bundled.json';

type Entry = {
  id: string; url: string; shape: string; color: string;
  title: string; siteName?: string; blurb?: string; notes?: string;
  category?: string; adSupported?: boolean; blockAds?: boolean; termsUrl?: string;
};

/** The apps that ship inside the download. No address to copy: they are there. */
const bundled = (bundledData.apps as Array<{
  id: string; title: string; siteName?: string; blurb?: string;
  category?: string; shape: string; color: string; ours?: boolean;
  credit: string; licence: string; sourceUrl: string;
}>).map((b) => ({
  ...b,
  name: b.siteName || b.title,
  art: SHAPES[b.shape] ?? SHAPES.star
}));

// Ours is read out of the same manifest as the rest rather than written here,
// so a second one added to config/bundled.json arrives on this page on its own.
// It gets its own section because the sentence above the others -- other
// people's open-source work, credited to them -- is not true of it.
const ours = bundled.filter((b) => b.ours === true);

/** Where each of ours lives on this site: its icon, the app, its page, a picture of it. */
const PAGES: Record<string, { icon: string; open: string; more: string; shot: string }> = {
  colouring: {
    icon: '/assets/playground-colouring.png', open: '/playground/colouring/', more: '/colouring/',
    shot: '/screenshots/colouring/01-a-page-in-progress.png'
  },
  studio: {
    icon: '/assets/playground-studio.png', open: '/playground/studio/', more: '/studio/',
    shot: '/screenshots/studio/01-hello.png'
  }
};
const theirs = bundled.filter((b) => b.ours !== true);

const entries = (data.suggestions as Entry[]).map((e) => {
  let host = e.url;
  try { host = new URL(e.url).host; } catch { /* leave it as written */ }
  return {
    ...e,
    host,
    name: e.siteName || e.title,
    say: e.blurb || e.notes || '',
    art: SHAPES[e.shape] ?? SHAPES.star,
    ads: e.adSupported
      ? (e.blockAds === false
        ? { text: 'Adverts shown', cls: 'chip--ads' }
        : { text: 'Adverts filtered', cls: 'chip--filtered' })
      : { text: 'No adverts', cls: 'chip--free' }
  };
});
---

<Base
  title="The Sukhi Play catalogue"
  description="Compatible sites you can add to Sukhi Play, and the apps that come with it. Copy an address and the app sets the rest up."
  page="catalogue">

  <main class="wrap">
    <div class="hero hero--page">
      <h1>What you can add</h1>
      <p class="lede">Sites that work in Sukhi Play. Copy an address, paste it
        into the app, and it sets the rest up for you.</p>
    </div>

    <!-- Ours, given its own section rather than a chip in the grid below. The
         sentence over that grid -- other people's open-source work, credited
         to them -- is the one thing that is not true of this, and being the
         first app written for Sukhi Play rather than allowed into it is worth
         more than a badge. -->
    {ours.map((b) => (
      <section class="cat-first" style={`--art:${b.color}`}>
        <div class="cat-first-say">
          <div class="cat-first-tag">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.2 2.6 3.3v4.1c0 3.3 2.3 6.2 5.4 7.4 3.1-1.2 5.4-4.1 5.4-7.4V3.3z" fill="currentColor"/><path d="m5.4 8 1.8 1.8 3.4-3.6" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Official &middot; by Sukhi Play
          </div>
          <div class="cat-first-name">
            <img src={PAGES[b.id]?.icon} alt="" width="64" height="64" loading="lazy">
            <h2>{b.name}</h2>
          </div>
          <p class="cat-first-line">{b.blurb}</p>
          <p class="cat-first-go">
            <a class="go" href={PAGES[b.id]?.open} target="_blank" rel="noopener">Open the app</a>
            <a class="go go--ghost" href={PAGES[b.id]?.more}>Read more</a>
          </p>
          <p class="cat-first-promise">No ads &middot; No tracking &middot; Works offline</p>
        </div>
        <a class="cat-first-shot" href={PAGES[b.id]?.more} tabindex="-1" aria-hidden="true">
          <img src={PAGES[b.id]?.shot} alt="" width="1240" height="800" loading="lazy" decoding="async">
        </a>
      </section>
    ))}

    <!-- Kept apart from the sites below. These need no address, no hosts and
         no connection, so putting them in the same grid with a Copy button
         would be offering to copy something that is already installed. -->
    <section class="cat-inside">
      <div class="cat-head cat-head--badged">
        <div>
          <h2>Also inside Sukhi Play</h2>
          <p>These come with the app. They need no internet at all, so they work
            on a train, in the car, and when the broadband is having a day.</p>
        </div>
        <!-- One badge for the section rather than the same chip on all three:
             it is true of every app here, so saying it once says it better. -->
        <span class="offline-badge">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 19h.01M5 12.5a10 10 0 0 1 14 0M2 8.8a15 15 0 0 1 20 0M8.5 16a5 5 0 0 1 7 0"
                  fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            <path d="M3 3l18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          Works offline
        </span>
      </div>
      <div class="inside-grid">
        {theirs.map((b) => (
          <article class="inside-card" style={`--art:${b.color}`}>
            <span class="cat-art" aria-hidden="true"><svg viewBox="0 0 100 100" set:html={b.art} /></span>
            <div class="inside-say">
              <h3>{b.name}</h3>
              <div class="cat-chips">
                <span class="chip">{b.category || 'Other'}</span>
              </div>
            </div>
            <p class="inside-blurb">{b.blurb}</p>
            <a class="inside-credit" href={b.sourceUrl} rel="noopener">{b.credit}</a>
          </article>
        ))}
      </div>
    </section>

    <div class="cat-head cat-head--sites">
      <h2>Compatible sites you can add</h2>
      <p>These are known to work. Copy an address, paste it into the app, and
        it fills in the rest.</p>
    </div>

    <div class="cat-grid">
      {entries.map((e) => (
        <article class="cat-card" style={`--art:${e.color}`}>
          <span class="cat-art" aria-hidden="true"><svg viewBox="0 0 100 100" set:html={e.art} /></span>
          <h3>{e.name}</h3>
          <p>{e.say}</p>
          <div class="cat-chips">
            <span class="chip">{e.category || 'Other'}</span>
            <span class:list={['chip', e.ads.cls]}>{e.ads.text}</span>
          </div>
          <button class="cat-copy" type="button" data-copy={e.url}>
            <span>{e.host}</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="9" y="9" width="11" height="11" rx="2.5" fill="none" stroke="currentColor" stroke-width="2"/>
              <path d="M6 15H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v1" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
            <em>Copy</em>
          </button>
          {e.termsUrl && (
            <a class="cat-terms" href={e.termsUrl} rel="nofollow noopener">Their terms</a>
          )}
        </article>
      ))}
    </div>

    <div class="cat-note">
      <p>Sukhi Play is not connected to any of these sites and is not endorsed
        by them. It does not check what they show, so what your child opens is
        your choice — have a look yourself first.</p>
      <p>Run one of these sites and want it off this page?
        <a href={`${REPO}/issues`}>Open an issue</a> and it goes, no questions asked.</p>
    </div>
  </main>
</Base>

<script>
  // Copy the address, because typing one out on a laptop with a toddler on
  // your lap is the whole reason this page exists.
  document.querySelectorAll<HTMLButtonElement>('.cat-copy').forEach((b) => {
    b.addEventListener('click', () => {
      const label = b.querySelector('em');
      if (!label || !b.dataset.copy) return;
      navigator.clipboard.writeText(b.dataset.copy).then(
        () => {
          label.textContent = 'Copied';
          b.classList.add('is-done');
          setTimeout(() => { label.textContent = 'Copy'; b.classList.remove('is-done'); }, 1600);
        },
        () => { label.textContent = 'Press Ctrl+C'; }
      );
    });
  });
</script>
