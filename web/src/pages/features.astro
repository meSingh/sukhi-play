---
/**
 * The features page, in two acts: what a child meets, and what a parent
 * decides. Within each, a grid of tiles that are deliberately not the same
 * size or the same kind -- a screenshot, a number, a sentence on a colour --
 * so the important things are big and the small ones stay small.
 */
import Base from '../layouts/Base.astro';
import Tile from '../components/Tile.astro';
import { REPO } from '../site';

import launcher from '../images/01-launcher.png';
import portal from '../images/02-parent-portal.png';
import addApp from '../images/03-add-an-app.png';
import closing from '../images/05-closing-needs-a-grownup.png';

const REST = [
  ['No favicons, no logos', 'Every tile is a shape and a colour we drew. Nothing is fetched from the sites you add.'],
  ['Keyboard shortcuts held', 'Alt+Tab, Alt+F4, Command+Q, Print Screen. The Windows key is the one exception, and we say so.'],
  ['No downloads', 'A site cannot write a file. The one thing that can is a bundled app saving your child’s picture.'],
  ['It sets itself up', 'The first run picks a few sites with you and asks how you want to get back in.'],
  ['Free and open source', 'MIT licensed. Every line is public, including the parts that decide what your child can reach.'],
  ['Works on your machine', 'macOS, Windows and Linux. No account, no payment, no trial.']
];
---

<Base
  title="Everything Sukhi Play does"
  description="A locked screen, a play-time limit that ends by itself, adverts filtered, apps that work with no internet, and a grown-up gate a three-year-old cannot pass. Free and open source."
  page="features">

  <main>
    <div class="wrap">
      <div class="hero hero--page">
        <h1>Hand it over.<br><em>Keep your work.</em></h1>
        <p class="lede">Two screens, really: the one your child gets, and the
          one only you can reach. Here is everything on both.</p>
      </div>
    </div>

    <!-- Act one. -->
    <section class="act">
      <div class="wrap">
        <header class="act-head">
          <span class="act-num">01</span>
          <h2>What your child gets</h2>
          <p>A screen with no way out of it, and nothing on it you did not put there.</p>
        </header>

        <div class="bento">
          <Tile title="Only what you chose" span={2} tall shot={launcher}
                alt="The Sukhi Play tile screen: six large coloured tiles, each a site a parent added."
                tone="paper">
            <p>Full screen, no address bar, no new tab, no back button out of
              it. A child who taps everything finds only these tiles.</p>
          </Tile>

          <Tile title="Adverts and trackers, refused" span={2} tone="mint"
                stat="1,284" statNote="cut in one afternoon">
            <p>Blocked before they load, on every site you add.</p>
          </Tile>

          <Tile title="Apps that need no internet" tone="violet" stat="3">
            <p>A colouring book, a keyboard playground and first games, inside
              the download.</p>
          </Tile>

          <Tile title="Nothing is sent anywhere" tone="cyan" stat="0"
                statNote="accounts, trackers, reports">
            <p>No sign-in, no analytics, nothing phoning home.</p>
          </Tile>

          <Tile title="Then it stops by itself" span={2} tall shot={closing}
                alt="The screen shown when play time is over, offering to ask a grown-up for more."
                tone="paper">
            <p>No argument, because it was never your decision in the moment.
              The countdown only appears in the last thirty seconds, so there
              is nothing to watch or bargain with.</p>
          </Tile>
        </div>
      </div>
    </section>

    <!-- Act two, on ink, so the two halves are visibly different places. -->
    <section class="act act--dark">
      <div class="wrap">
        <header class="act-head">
          <span class="act-num">02</span>
          <h2>What only you can reach</h2>
          <p>Behind a gate a three-year-old does not get through.</p>
        </header>

        <div class="bento">
          <Tile title="The grown-up screen" span={2} tall shot={portal}
                alt="The grown-up screen, with tabs for play time, installed apps, the catalogue and settings."
                tone="paper">
            <p>Play time, the apps, the catalogue and every setting, in one
              place your child cannot open.</p>
          </Tile>

          <Tile title="Hold it for three seconds" span={2} tone="ink">
            <span class="hold-demo" aria-hidden="true">
              <span class="hold-ring"><b>Hold</b></span>
            </span>
            <p>Quick taps do nothing at all. If your child ever works the hold
              out, swap it for a small sum instead.</p>
          </Tile>

          <Tile title="Set the session once" span={2} tone="ink"
                stat="20" statNote="minutes, every time it opens">
            <p>A standing rule, not a decision you make again each time. When
              it runs out you can grant fifteen minutes, an hour, or the rest
              of the day — and your usual limit stays where it is.</p>
          </Tile>

          <Tile title="Add any site by its address" span={2} tall shot={addApp}
                alt="The add-an-app form, with a name, a picture, a colour and an address."
                tone="paper">
            <p>Paste an address. Sukhi Play loads it, works out which hosts it
              needs, and suggests a name and a picture — change any of it
              before you save. Or start from <a href="/catalogue/">the
              catalogue</a>.</p>
          </Tile>
        </div>
      </div>
    </section>

    <!-- The short ones, as a quiet run rather than a third grid. -->
    <section class="wrap rest">
      <h2>And the rest</h2>
      <ul class="rest-list">
        {REST.map(([h, p]) => (
          <li><b>{h}</b><span>{p}</span></li>
        ))}
      </ul>
    </section>
  </main>

  <section class="closer">
    <div class="wrap">
      <h2>Ready when you are</h2>
      <p>macOS, Windows and Linux. Free, no account, no payment, no trial.</p>
      <a class="big-dl" href="/download/">Download Sukhi Play</a>
      <p class="closer-note">It works with no internet once it is installed.
        <a href={REPO}>Read the code</a>.</p>
    </div>
  </section>

  <dialog class="shot-box" id="shot-box">
    <button class="shot-close" type="button" aria-label="Close">&times;</button>
    <img id="shot-box-img" src="" alt="">
  </dialog>
</Base>

<script>
  const box = document.getElementById('shot-box') as HTMLDialogElement | null;
  const img = document.getElementById('shot-box-img') as HTMLImageElement | null;
  if (box && img) {
    document.querySelectorAll<HTMLButtonElement>('.bt-shot').forEach((b) => {
      b.addEventListener('click', () => {
        // The full-resolution original, not the one sized for the tile: the
        // point of enlarging a picture of a screen is to read the screen.
        img.src = b.dataset.full ?? '';
        img.alt = b.dataset.alt ?? '';
        box.showModal();
      });
    });
    const shut = () => box.close();
    box.querySelector('.shot-close')?.addEventListener('click', shut);
    box.addEventListener('click', (e) => { if (e.target === box) shut(); });
    box.addEventListener('close', () => { img.src = ''; });
  }
</script>
