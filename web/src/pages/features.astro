---
/**
 * The features page, written as worries rather than features.
 *
 * The homepage headline is a fear and its relief -- "Your inbox stays shut.
 * No surprise emails." This page carries the same voice the whole way down,
 * one worry per screen. The version before this named each screen and
 * numbered the parts of it, which is a manual: it explains a product to
 * somebody who has already decided, and says nothing to a parent standing
 * there with a laptop and a three-year-old.
 */
import Base from '../layouts/Base.astro';
import Screen from '../components/Screen.astro';
import { REPO } from '../site';

import launcher from '../images/01-launcher.png';
import portal from '../images/02-parent-portal.png';
import addApp from '../images/03-add-an-app.png';
import closing from '../images/05-closing-needs-a-grownup.png';

const REST = [
  ['Nothing downloads itself', 'A site cannot open a window, start a download, or ask for your camera. No mystery installs in your Downloads folder on Sunday night.'],
  ['The keyboard is safe to bash', 'Alt+Tab, Alt+F4, Command+Q, Print Screen — held down while the window has focus. The Windows key is the one exception and we say so on the Windows page, rather than hoping you do not notice.'],
  ['Nothing is sent anywhere', 'No sign-in, no account, no analytics, no telemetry, no crash reports. The only request Sukhi Play makes on its own is checking for a newer version, and only when you press the button.'],
  ['It costs nothing, and always will', 'MIT licensed and open source. Every line is public, including the parts that decide what your child can reach.']
];
---

<Base
  title="Everything Sukhi Play does"
  description="Every worry about handing a child your laptop, and what Sukhi Play does about each one. They cannot close it, cannot wander off, and cannot argue with the clock."
  page="features">

  <main>
    <div class="wrap">
      <header class="f-hero">
        <p class="f-kicker">One worry at a time</p>
        <h1>You hand it over.<br><em>Then you hover.</em></h1>
        <p class="lede">Everybody does, the first time. Here is each thing you
          are watching for, and what happens to it — on the real screens, not
          a diagram of them.</p>
      </header>
    </div>

    <Screen
      fear="They tap everything."
      relief="Nothing breaks."
      shot={launcher}
      alt="The Sukhi Play tile screen: six large coloured tiles, each a site a parent added, with a grown-ups button in the corner."
      caption="The whole screen your child gets.">
      <p>Every key, both mouse buttons, the same corner forty times. There is
        no address bar to type into, no tab to close, no window to drag off the
        edge and no file to delete. The worst thing a small child can do here
        is open a different one of the sites you chose.</p>
      <p class="worry-aside">Your work stays exactly where you left it.</p>
    </Screen>

    <!-- Shown, not photographed: a claim about what a child cannot do is
         worth more when the person reading it can try it themselves. -->
    <section class="gate-band">
      <div class="wrap">
        <div class="gate-band-in">
          <div class="gate-say">
            <h2>They will try to get out.<br><em>Three seconds says no.</em></h2>
            <p>Not a PIN they watch you type. Not a swipe they learn in a week.
              A steady three-second press, which is simply not a motion a
              toddler makes — they tap, and a tap does nothing at all.</p>
            <p class="gate-note">If yours ever works it out, swap it for a
              small sum and the hold stops working entirely.</p>
          </div>
          <div class="gate-try">
            <button class="try-ring" id="try-hold" type="button" aria-label="Press and hold to try the gate">
              <svg class="try-prog" viewBox="0 0 120 120" aria-hidden="true">
                <circle cx="60" cy="60" r="54" class="try-track"/>
                <circle cx="60" cy="60" r="54" class="try-fill"/>
              </svg>
              <span class="try-label" id="try-label">Hold</span>
            </button>
            <p class="try-hint" id="try-hint">Go on — press it and keep pressing.</p>
          </div>
        </div>
      </div>
    </section>

    <Screen
      fear="“Five more minutes.”"
      relief="Not your argument any more."
      tone="ink"
      flip
      shot={closing}
      alt="The screen shown when play time is over: a card reading That is all for now, with a button to ask for more time and a quieter one for grown-ups to close the app."
      caption="It ends on its own, at the time you set.">
      <p>You decide the length once, on a quiet afternoon, and it starts again
        every time the app opens. Then the laptop is the one that says when —
        and a child who is cross about it is cross with the screen, which is a
        much better place for it than cross with you.</p>
      <p>No countdown ticking away to stare at, either. It appears in the last
        thirty seconds and not before.</p>
      <p class="worry-aside">Still yours to overrule: fifteen minutes, an hour,
        or the rest of the day — without moving your usual limit.</p>
    </Screen>

    <!-- Adverts are a number, so they are shown as one. -->
    <section class="ads-band">
      <div class="wrap">
        <div class="ads-in">
          <p class="ads-num"><b>1,284</b><span>requests refused in one afternoon</span></p>
          <div class="ads-say">
            <h2>Nothing is trying to sell<br><em>to your three-year-old.</em></h2>
            <p>Advert and tracker requests are cut before they load, on every
              site you add. No pop-ups, no interstitial begging for a tap, no
              profile being built out of what a small child clicked.</p>
            <p class="gate-note">A handful of sites ask in their terms that you
              do not filter them. You can leave those alone per site — your
              child still cannot wander off them either way.</p>
          </div>
        </div>
      </div>
    </section>

    <Screen
      fear="Nobody else picks what is next."
      relief="You already did."
      shot={portal}
      alt="The grown-up screen, with tabs for play time, installed apps, the catalogue and settings, showing six installed apps with on-off switches."
      caption="Your side of it, behind the gate.">
      <p>No autoplay into something you have not seen. No recommendation rail.
        No next video chosen by an algorithm that has never met your child. The
        tiles are the ones you put there, and the list stops where you stopped
        it.</p>
      <p>Hide one for a week without deleting it. Change a name, a colour, the
        shape on the tile. Quit from the corner, where it belongs.</p>
    </Screen>

    <Screen
      fear="Adding a site takes a minute."
      relief="Not an afternoon."
      tone="ink"
      flip
      shot={addApp}
      alt="The add-an-app form, with a name, a picture, a colour, an address and a switch for filtering adverts."
      caption="Paste an address; it works out the rest.">
      <p>Sukhi Play opens the site, watches what it actually needs, and fills in
        the rest — a name, a picture, a colour, the list of hosts to allow. You
        see all of it and change anything before you save.</p>
      <p>Or take one from <a href="/catalogue/">the catalogue</a>, already set
        up. Three of those are not websites at all: a colouring book, a
        keyboard playground and a set of first games that come inside the
        download and work on a train.</p>
    </Screen>

    <section class="wrap rest">
      <h2>And the small print, which is short</h2>
      <ul class="rest-list">
        {REST.map(([h, p]) => (
          <li><b>{h}</b><span>{p}</span></li>
        ))}
      </ul>
    </section>
  </main>

  <section class="closer">
    <div class="wrap">
      <h2>Hand it over. Keep your work.</h2>
      <p>macOS, Windows and Linux. Free, no account, no payment, no trial.</p>
      <a class="big-dl" href="/download/">Download Sukhi Play</a>
      <p class="closer-note">It works with no internet once it is installed.
        <a href={REPO}>Read the code</a>.</p>
    </div>
  </section>

  <dialog class="shot-box" id="shot-box">
    <button class="shot-close" type="button" aria-label="Close">&times;</button>
    <img id="shot-box-img" src="" alt="">
  </dialog>
</Base>

<script>
  /* Enlarging a screen, because a picture of a screen is worth reading. */
  const box = document.getElementById('shot-box') as HTMLDialogElement | null;
  const img = document.getElementById('shot-box-img') as HTMLImageElement | null;
  if (box && img) {
    document.querySelectorAll<HTMLButtonElement>('.worry-shot button').forEach((b) => {
      b.addEventListener('click', () => {
        img.src = b.dataset.full ?? '';
        img.alt = b.dataset.alt ?? '';
        box.showModal();
      });
    });
    const shut = () => box.close();
    box.querySelector('.shot-close')?.addEventListener('click', shut);
    box.addEventListener('click', (e) => { if (e.target === box) shut(); });
    box.addEventListener('close', () => { img.src = ''; });
  }

  /* The real gate, at the real three seconds. */
  const HOLD = 3000;
  const LEN = 339.3;                       // circumference of r=54
  const btn = document.getElementById('try-hold');
  const fill = document.querySelector<SVGCircleElement>('.try-fill');
  const label = document.getElementById('try-label');
  const hint = document.getElementById('try-hint');

  if (btn && fill && label && hint && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let started = 0, raf = 0, level = 0, holding = false, done = false;
    const paint = (v: number) => {
      level = Math.max(0, Math.min(1, v));
      fill.style.strokeDashoffset = String(LEN * (1 - level));
    };
    paint(0);

    const tick = () => {
      if (!holding) return;
      paint((performance.now() - started) / HOLD);
      if (level >= 1) {
        done = true;
        btn.classList.add('is-open');
        label.textContent = 'Open';
        hint.textContent = 'That is the whole gate. Now imagine doing it by accident.';
        return;
      }
      hint.textContent = 'Keep holding…';
      raf = requestAnimationFrame(tick);
    };
    const drain = () => {
      cancelAnimationFrame(raf);
      const from = level, t0 = performance.now();
      const back = () => {
        const p = Math.max(0, from - (performance.now() - t0) / 420);
        paint(p);
        if (p > 0) requestAnimationFrame(back);
      };
      requestAnimationFrame(back);
    };
    const down = (e: Event) => {
      if (done) return;
      e.preventDefault();
      holding = true;
      cancelAnimationFrame(raf);
      started = performance.now() - level * HOLD;
      raf = requestAnimationFrame(tick);
    };
    const up = () => {
      if (!holding || done) return;
      holding = false;
      hint.textContent = 'Let go too soon. That is every tap a toddler makes.';
      drain();
    };
    btn.addEventListener('pointerdown', down);
    ['pointerup', 'pointerleave', 'pointercancel'].forEach((t) => btn.addEventListener(t, up));
    btn.addEventListener('contextmenu', (e) => e.preventDefault());
    btn.addEventListener('keydown', (e) => {
      const k = e as KeyboardEvent;
      if ((k.key === ' ' || k.key === 'Enter') && !k.repeat) down(e);
    });
    btn.addEventListener('keyup', (e) => {
      const k = e as KeyboardEvent;
      if (k.key === ' ' || k.key === 'Enter') up();
    });
  }
</script>
