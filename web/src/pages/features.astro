---
/**
 * A tour of the real screens, in the order a parent meets them.
 *
 * The homepage is the pitch: abstractions, a demo you can press, a mascot.
 * This page is the reference, and its job is to show the actual application
 * large enough to read, with the parts worth noticing pointed at.
 */
import Base from '../layouts/Base.astro';
import Screen from '../components/Screen.astro';
import { REPO } from '../site';

import launcher from '../images/01-launcher.png';
import portal from '../images/02-parent-portal.png';
import addApp from '../images/03-add-an-app.png';
import closing from '../images/05-closing-needs-a-grownup.png';

const REST = [
  ['No favicons, no logos', 'Every picture on a tile is a shape and a colour we drew. Nothing is fetched from the sites you add, so nothing on your child’s screen is theirs to change.'],
  ['Keyboard shortcuts held down', 'Alt+Tab, Alt+F4, Command+Q, Print Screen and the rest are caught while the window has focus. The Windows key is the one exception, and we say so on the Windows page rather than hoping you do not notice.'],
  ['No downloads, no popups, no new windows', 'A site cannot open a window, start a download, or ask for your camera. The one thing that may write a file is a bundled app saving a picture your child drew.'],
  ['Nothing is sent anywhere', 'No sign-in, no analytics, no telemetry, no crash reporting. The only request Sukhi Play makes on its own is checking for a newer version, and only when you press the button.'],
  ['Free, and open source', 'MIT licensed. Every line is public, including the parts that decide what your child can reach.']
];
---

<Base
  title="Everything Sukhi Play does"
  description="A tour of every screen: the locked play zone, the grown-up screen behind a real gate, play time that ends by itself, and adding any site by its address."
  page="features">

  <main>
    <div class="wrap">
      <header class="hero hero--page f-hero">
        <p class="f-kicker">A look at every screen</p>
        <h1>Hand it over.<br><em>Keep your work.</em></h1>
        <p class="lede">Four screens, and only one of them is your child’s.
          Here is each, at a size you can actually read.</p>
      </header>
    </div>

    <Screen
      title="The play zone"
      lede="What your child sees, every time. It fills the display and there is no way out of it."
      shot={launcher}
      alt="The Sukhi Play tile screen: six large coloured tiles, each a site a parent added, with a grown-ups button in the corner."
      pins={[
        { x: 30, y: 5, what: 'No address bar, and nothing to type into', side: 'right' },
        { x: 85.5, y: 5, what: 'The only way to the grown-up screen', side: 'left' },
        { x: 50, y: 62, what: 'Only the sites you added, as big soft buttons', side: 'right' }
      ]}>
      <p>No new tab, no back button out of it, and no link that leads anywhere
        you did not allow. A child who taps everything finds only these tiles.</p>
    </Screen>

    <Screen
      title="The grown-up screen"
      lede="Everything you decide, in one place your child cannot open."
      tone="ink"
      shot={portal}
      alt="The grown-up screen, with tabs for play time, installed apps, the catalogue and settings, showing six installed apps with on-off switches."
      pins={[
        { x: 15, y: 13.5, what: 'Play time, apps, catalogue, settings', side: 'right' },
        { x: 28, y: 33, what: 'Hide an app without deleting it', side: 'right' },
        { x: 18, y: 62, what: 'Sites whose terms ask us not to filter say so', side: 'right' },
        { x: 91, y: 5, what: 'Quitting is here, not hidden in a menu', side: 'left' }
      ]}>
      <p>Getting in means holding a button for three seconds — or answering a
        small sum, if your child ever works the hold out.</p>
    </Screen>

    <!-- The gate is a behaviour, not a screen, so it is shown rather than
         photographed: the same button the homepage lets you try. -->
    <section class="gate-band">
      <div class="wrap">
        <div class="gate-band-in">
          <div class="gate-say">
            <h2>Little fingers tap.<br><em>Grown-ups hold.</em></h2>
            <p>A quick tap does nothing at all — which is every tap a small
              child makes. Three full seconds of steady pressure is a different
              motion, and it is the one thing standing between your child and
              the rest of your laptop.</p>
            <p class="gate-note">Prefer a sum? Switch it in settings and the
              hold stops working entirely.</p>
          </div>
          <div class="gate-try">
            <button class="try-ring" id="try-hold" type="button" aria-label="Press and hold">
              <svg class="try-prog" viewBox="0 0 120 120" aria-hidden="true">
                <circle cx="60" cy="60" r="54" class="try-track"/>
                <circle cx="60" cy="60" r="54" class="try-fill"/>
              </svg>
              <span class="try-label" id="try-label">Hold</span>
            </button>
            <p class="try-hint" id="try-hint">Try it — press and keep pressing.</p>
          </div>
        </div>
      </div>
    </section>

    <Screen
      title="When play time is up"
      lede="It ends by itself, so it was never your decision in the moment."
      shot={closing}
      alt="The screen shown when play time is over: a card reading That is all for now, with a button to ask for more time and a quieter one for grown-ups to close the app."
      pins={[
        { x: 50, y: 58, what: 'Your child can ask; only you can answer', side: 'right' },
        { x: 50, y: 66, what: 'And a way out that is always there', side: 'right' }
      ]}>
      <p>Set the session length once and it starts again every time the app
        opens. The countdown only appears in the last thirty seconds, so there
        is nothing to watch or bargain with. Grant fifteen minutes, an hour or
        the rest of the day when it runs out — your usual limit does not move.</p>
    </Screen>

    <Screen
      title="Adding a site"
      lede="Paste an address. Sukhi Play works out the rest and shows you before it saves."
      tone="ink"
      shot={addApp}
      alt="The add-an-app form, with a name, a picture, a colour, an address and a switch for filtering adverts."
      pins={[
        { x: 42, y: 40, what: 'Pick a shape and a colour — never a favicon', side: 'right' },
        { x: 48, y: 68, what: 'The address, and the hosts it needs, found for you', side: 'right' },
        { x: 30, y: 82, what: 'Advert filtering, on unless you say otherwise', side: 'right' }
      ]}>
      <p>Or start from <a href="/catalogue/">the catalogue</a>: sites already
        set up, and three apps that come with the download and need no internet
        at all.</p>
    </Screen>

    <section class="wrap rest">
      <h2>And the rest</h2>
      <ul class="rest-list">
        {REST.map(([h, p]) => (
          <li><b>{h}</b><span>{p}</span></li>
        ))}
      </ul>
    </section>
  </main>

  <section class="closer">
    <div class="wrap">
      <h2>Ready when you are</h2>
      <p>macOS, Windows and Linux. Free, no account, no payment, no trial.</p>
      <a class="big-dl" href="/download/">Download Sukhi Play</a>
      <p class="closer-note">It works with no internet once it is installed.
        <a href={REPO}>Read the code</a>.</p>
    </div>
  </section>

  <dialog class="shot-box" id="shot-box">
    <button class="shot-close" type="button" aria-label="Close">&times;</button>
    <img id="shot-box-img" src="" alt="">
  </dialog>
</Base>

<script>
  /* Enlarging a screen, because a picture of a screen is worth reading. */
  const box = document.getElementById('shot-box') as HTMLDialogElement | null;
  const img = document.getElementById('shot-box-img') as HTMLImageElement | null;
  if (box && img) {
    document.querySelectorAll<HTMLButtonElement>('.screen-shot').forEach((b) => {
      b.addEventListener('click', () => {
        img.src = b.dataset.full ?? '';
        img.alt = b.dataset.alt ?? '';
        box.showModal();
      });
    });
    const shut = () => box.close();
    box.querySelector('.shot-close')?.addEventListener('click', shut);
    box.addEventListener('click', (e) => { if (e.target === box) shut(); });
    box.addEventListener('close', () => { img.src = ''; });
  }

  /* The real hold, on the page, at the real three seconds. Claiming a child
     cannot do it and then not letting a parent try would be a weaker claim. */
  const HOLD = 3000;
  const LEN = 339.3;                       // circumference of r=54
  const btn = document.getElementById('try-hold');
  const fill = document.querySelector<SVGCircleElement>('.try-fill');
  const label = document.getElementById('try-label');
  const hint = document.getElementById('try-hint');

  if (btn && fill && label && hint && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let started = 0, raf = 0, level = 0, holding = false, done = false;
    const paint = (v: number) => {
      level = Math.max(0, Math.min(1, v));
      fill.style.strokeDashoffset = String(LEN * (1 - level));
    };
    paint(0);

    const tick = () => {
      if (!holding) return;
      paint((performance.now() - started) / HOLD);
      if (level >= 1) {
        holding = true; done = true;
        btn.classList.add('is-open');
        label.textContent = 'Open';
        hint.textContent = 'That is the whole gate. Three seconds, every time.';
        return;
      }
      hint.textContent = 'Keep holding…';
      raf = requestAnimationFrame(tick);
    };
    const drain = () => {
      cancelAnimationFrame(raf);
      const from = level, t0 = performance.now();
      const back = () => {
        const p = Math.max(0, from - (performance.now() - t0) / 420);
        paint(p);
        if (p > 0) requestAnimationFrame(back);
      };
      requestAnimationFrame(back);
    };
    const down = (e: Event) => {
      if (done) return;
      e.preventDefault();
      holding = true;
      cancelAnimationFrame(raf);
      started = performance.now() - level * HOLD;
      raf = requestAnimationFrame(tick);
    };
    const up = () => {
      if (!holding || done) return;
      holding = false;
      hint.textContent = 'Let go too soon. That is the point.';
      drain();
    };
    btn.addEventListener('pointerdown', down);
    ['pointerup', 'pointerleave', 'pointercancel'].forEach((t) => btn.addEventListener(t, up));
    btn.addEventListener('contextmenu', (e) => e.preventDefault());
    btn.addEventListener('keydown', (e) => {
      const k = e as KeyboardEvent;
      if ((k.key === ' ' || k.key === 'Enter') && !k.repeat) down(e);
    });
    btn.addEventListener('keyup', (e) => {
      const k = e as KeyboardEvent;
      if (k.key === ' ' || k.key === 'Enter') up();
    });
  }
</script>
