---
/**
 * The blog's front page: the newest post large, then everything by kind.
 *
 * Guides come first among the groups, because they are what a parent arrives
 * from a search looking for; announcements and the stories behind them
 * follow. Every post is a plain link, so the whole blog is crawlable from
 * here with no script.
 */
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import { AUTHOR, KINDS, isoDate, longDate, posts } from '../../blog';
import { SITE } from '../../site';

const all = await posts();
const [newest, ...rest] = all;
const groups = (['guide', 'announcement', 'story'] as const)
  .map((k) => ({ key: k, name: KINDS[k].plural, items: rest.filter((p) => p.data.kind === k) }))
  .filter((g) => g.items.length);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${SITE}/blog/#blog`,
  name: 'The Sukhi Play blog',
  url: `${SITE}/blog/`,
  description: 'Announcements, guides for parents of small children, and what happened behind the scenes, by Mandeep Singh.',
  inLanguage: 'en-GB',
  author: AUTHOR,
  blogPost: all.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    url: `${SITE}/blog/${p.id}/`,
    datePublished: isoDate(p.data.date),
    description: p.data.description
  }))
};
---

<Base
  title="The Sukhi Play blog: small children, screens, and what I am making"
  description="Guides for parents of small children on screens and laptops, announcements about Sukhi Play and its apps, and what went on behind the scenes. By Mandeep Singh."
  page="blog"
  schema={schema}>

  <main class="wrap blog-index">
    <header class="hero hero--page">
      <p class="f-kicker">The blog</p>
      <h1>Small children, screens, and what I am making</h1>
      <p class="lede">I built Sukhi Play for my son. Here I write about what
        works with small children and computers, what is new, and what went
        wrong along the way.</p>
      <p class="blog-feed"><a href="/blog/rss.xml">Follow by RSS</a></p>
    </header>

    {newest && (
      <a class="blog-lead" href={`/blog/${newest.id}/`}>
        {newest.data.image && <Img src={newest.data.image} alt="" loading="eager" sizes="(min-width: 900px) 520px, 92vw" />}
        <span class="blog-lead-say">
          <small>{KINDS[newest.data.kind].plural} &middot; {longDate(newest.data.date)}</small>
          <b>{newest.data.title}</b>
          <span>{newest.data.description}</span>
          <em>Read it</em>
        </span>
      </a>
    )}

    {groups.map((g) => (
      <section class="blog-group" data-section={g.name.toLowerCase()}>
        <h2>{g.name}</h2>
        <div class="blog-cards">
          {g.items.map((p) => (
            <a class="blog-card" href={`/blog/${p.id}/`}>
              <small><time datetime={isoDate(p.data.date)}>{longDate(p.data.date)}</time></small>
              <b>{p.data.title}</b>
              <span>{p.data.description}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</Base>
