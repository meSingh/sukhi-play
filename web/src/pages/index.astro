---
/**
 * Ported from the hand-written docs/index.html. The body is that page's own
 * markup; the header, footer and stylesheet now come from the layout.
 */
import Base from '../layouts/Base.astro';
---

<Base title="Sukhi Play, a locked-down browser for a small child" description="Hand a child the laptop without handing over your work. Sukhi Play locks the screen to the websites you chose. Free, open source, for macOS, Windows and Linux." page="index">
<main>
  <div class="wrap">
    <div class="hero">
      <img class="mark bob" src="/assets/cutout-proud.png" alt="" width="104" height="104">
      <h1 class="rotator">
        <span class="sr-only">Hand over the laptop, keep your work. Sukhi Play keeps a small child inside the websites you chose.</span>
      <span class="sizer" aria-hidden="true">Hand over the laptop.<br>Keep your work.</span>
      <span class="sizer" aria-hidden="true">Let them press every key.<br>Nothing happens.</span>
      <span class="sizer" aria-hidden="true">Your inbox stays shut.<br>No surprise emails.</span>
      <span class="sizer" aria-hidden="true">No wandering off.<br>Only the sites you picked.</span>
      <span class="sizer" aria-hidden="true">Tiny hands can’t close it.<br>Only you can.</span>
      <span class="sizer" aria-hidden="true">Not one file deleted.<br>Not one tab closed.</span>
      <span class="sizer" aria-hidden="true">Popups can’t open.<br>Ads get filtered out.</span>
      <span class="sizer" aria-hidden="true">No accidental downloads.<br>No mystery installs.</span>
      <span class="sizer" aria-hidden="true">No sneaky YouTube detours.<br>Unless you said so.</span>
      <span class="sizer" aria-hidden="true">Screen time,<br>without the cleanup after.</span>
        <span class="live" aria-hidden="true"><span class="l1">Hand over the laptop.</span><br><span class="l2">Keep your work.</span></span>
      </h1>
      <p class="lede">The websites you chose, full screen, and nothing else.</p>
    </div>

    <div class="os reveal">
      <a href="/macos/" data-os="mac"><span class="yours" hidden>Your computer</span><svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="6" y="9" width="36" height="35" rx="10" fill="#17153A"/>
  <rect x="6" y="4.5" width="36" height="35" rx="10" fill="#fff" stroke="#17153A" stroke-width="3"/>
  <path transform="translate(12 10) " d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3" stroke="#3B6BFF" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
</svg><b>macOS</b><span>Apple Silicon &amp; Intel</span></a>
      <a href="/windows/" data-os="win"><span class="yours" hidden>Your computer</span><svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="7" y="7" width="15" height="15" rx="2.5" fill="#3B6BFF"/>
  <rect x="26" y="7" width="15" height="15" rx="2.5" fill="#17153A" opacity=".82"/>
  <rect x="7" y="26" width="15" height="15" rx="2.5" fill="#17153A" opacity=".82"/>
  <rect x="26" y="26" width="15" height="15" rx="2.5" fill="#3B6BFF"/>
</svg><b>Windows</b><span>10 and 11</span></a>
      <a href="/linux/" data-os="linux"><span class="yours" hidden>Your computer</span><svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <path d="M24 5c6 0 9 4.4 9 10v7c0 3 1.6 5 3.6 7.6 2.3 3 3.4 5.2 3.4 7.4 0 3.4-3 5-7 5-2.6 0-4-.7-5.2-1.4-1.2-.7-2.3-1.2-3.8-1.2s-2.6.5-3.8 1.2C19 41.3 17.6 42 15 42c-4 0-7-1.6-7-5 0-2.2 1.1-4.4 3.4-7.4C13.4 27 15 25 15 22v-7c0-5.6 3-10 9-10z" fill="#17153A"/>
  <ellipse cx="24" cy="30" rx="7.5" ry="9.5" fill="#FFF7EC"/>
  <circle cx="20.6" cy="15.5" r="2.6" fill="#fff"/><circle cx="27.4" cy="15.5" r="2.6" fill="#fff"/>
  <circle cx="20.9" cy="16" r="1.3" fill="#17153A"/><circle cx="27.1" cy="16" r="1.3" fill="#17153A"/>
  <path d="M24 18.4c1.9 0 3.2 1 3.2 2.1S25.9 22.8 24 22.8s-3.2-1.2-3.2-2.3 1.3-2.1 3.2-2.1z" fill="#FFBE18"/>
</svg><b>Linux</b><span>Snap, deb, AppImage</span></a>
    </div>
    <p class="note-small">Free &middot; No account &middot; Open source</p>

    <div class="device reveal">
      <picture>
        <source srcset="/assets/demo.webp" type="image/webp">
        <img src="/assets/demo.gif" width="1280" height="768" loading="lazy"
             alt="The app running: a child picking a tile and playing, adverts being counted as they are blocked, the one minute warning, the screen that stops play time, a grown-up holding the button for three seconds, and choosing to grant fifteen more minutes">
      </picture>
    </div>
    <p class="note-small">The real app, recorded start to finish. Nothing here is a mock-up.
      The site being played is a small demo page of ours, so no one else’s work is used to advertise this.</p>
  </div>

  <section class="band" style="margin-top:72px">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">Locked while they play</span>
        <h2>What they cannot reach</h2>
        <p>Everything unlocks again the moment you close it.</p>
      </div>
      <ul class="vault">
      <li><span class="lock" aria-hidden="true"><svg viewBox="0 0 24 24"><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><rect x="5" y="11" width="14" height="10" rx="2.5" fill="currentColor"/></svg></span><span class="art"><svg viewBox="0 0 48 48"><path d="M5 13a4 4 0 0 1 4-4h9.5l4 4H39a4 4 0 0 1 4 4v19a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4z" fill="#E9A23B"/><path d="M5 19h38v17a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4z" fill="#FFBE18"/><rect x="12" y="25" width="14" height="3" rx="1.5" fill="#fff" opacity=".7"/></svg></span>Your files<small>and folders</small></li>
      <li><span class="lock" aria-hidden="true"><svg viewBox="0 0 24 24"><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><rect x="5" y="11" width="14" height="10" rx="2.5" fill="currentColor"/></svg></span><span class="art"><svg viewBox="0 0 48 48"><rect x="5" y="10" width="38" height="28" rx="6" fill="#3B6BFF"/><path d="M8 14l16 12 16-12" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="40" cy="11" r="6" fill="#FF5C5C"/></svg></span>Your email<small>and messages</small></li>
      <li><span class="lock" aria-hidden="true"><svg viewBox="0 0 24 24"><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><rect x="5" y="11" width="14" height="10" rx="2.5" fill="currentColor"/></svg></span><span class="art"><svg viewBox="0 0 48 48"><rect x="4.5" y="9" width="39" height="31" rx="6" fill="#fff" stroke="#17153A" stroke-width="3"/><path d="M4.5 17.5h39" stroke="#17153A" stroke-width="3"/><rect x="9" y="11.5" width="9" height="3.6" rx="1.6" fill="#8B5CF6"/><rect x="20" y="11.5" width="9" height="3.6" rx="1.6" fill="#C9C6E0"/><rect x="10" y="23" width="19" height="3.2" rx="1.6" fill="#C9C6E0"/><rect x="10" y="29.5" width="26" height="3.2" rx="1.6" fill="#C9C6E0"/></svg></span>Your open tabs<small>and half-done work</small></li>
      <li><span class="lock" aria-hidden="true"><svg viewBox="0 0 24 24"><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><rect x="5" y="11" width="14" height="10" rx="2.5" fill="currentColor"/></svg></span><span class="art"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18" fill="#10D6A0"/><path d="M6 24h36M24 6c-6.5 5-6.5 31 0 36M24 6c6.5 5 6.5 31 0 36M9 15h30M9 33h30" fill="none" stroke="#fff" stroke-width="2.4"/></svg></span>Other websites<small>links, popups, redirects</small></li>
      <li><span class="lock" aria-hidden="true"><svg viewBox="0 0 24 24"><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><rect x="5" y="11" width="14" height="10" rx="2.5" fill="currentColor"/></svg></span><span class="art"><svg class="kb" viewBox="0 0 48 48"><rect x="2" y="11" width="44" height="27" rx="6" fill="#17153A"/><rect class="key" x="6.0" y="15.0" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="12.6" y="15.0" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="19.2" y="15.0" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="25.8" y="15.0" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="32.4" y="15.0" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="39.0" y="15.0" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="6.0" y="21.4" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="12.6" y="21.4" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="19.2" y="21.4" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="25.8" y="21.4" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="32.4" y="21.4" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="39.0" y="21.4" width="4.8" height="4.4" rx="1.2" fill="#5B5885"/><rect class="key" x="12.6" y="27.8" width="22.8" height="4.4" rx="1.2" fill="#5B5885"/></svg></span>Keyboard shortcuts<small>mash away</small></li>
      <li><span class="lock" aria-hidden="true"><svg viewBox="0 0 24 24"><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"/><rect x="5" y="11" width="14" height="10" rx="2.5" fill="currentColor"/></svg></span><span class="art"><svg viewBox="0 0 48 48"><circle cx="24" cy="24" r="18" fill="#FF5C5C"/><path d="M24 13.5v10" stroke="#fff" stroke-width="3.6" stroke-linecap="round"/><path d="M16.8 18a9.6 9.6 0 1 0 14.4 0" fill="none" stroke="#fff" stroke-width="3.6" stroke-linecap="round"/></svg></span>Closing the app<small>without a grown-up</small></li>
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">For you</span>
        <h2>Set up in a minute</h2>
        <p>No settings to understand. Type an address and it does the rest.</p>
      </div>

      <div class="tour reveal d1">
        <div class="tour-steps">
          <button type="button" data-step="0" class="on"><span class="n">1</span><b>Type an address</b><small>Or pick from a list</small><span class="bar"><i></i></span></button>
          <button type="button" data-step="1"><span class="n">2</span><b>It works out the rest</b><small>What it needs, what is an ad</small><span class="bar"><i></i></span></button>
          <button type="button" data-step="2"><span class="n">3</span><b>Hand it over</b><small>One big button per site</small><span class="bar"><i></i></span></button>
        </div>

        <div class="stage" aria-hidden="true">
          <span class="blob a"></span><span class="blob b"></span><span class="blob c"></span>
          <div class="appbar"><img src="/assets/sukhi-icon.png" alt="">Sukhi Play<span class="chip">Grown-ups</span><span class="chip">Close</span></div>
          <div class="launch"><h4>What do you want to do?</h4><div class="grid"><div class="tile" style="background:#2F48B8"><span class="face"><svg viewBox="0 0 24 24" fill="#2F48B8"><g transform="scale(.24)"><path d="M50 6c14 14 20 30 20 46v12H30V52c0-16 6-32 20-46Z"/><path d="M30 56 14 74l14-2 4 12Z"/><path d="M70 56l16 18-14-2-4 12Z"/><circle cx="50" cy="44" r="9" fill="rgba(0,0,0,.3)"/></g></svg></span>Poki</div></div></div>
          <div class="scrim">
            <div class="dialog">
              <div class="head">
                <span class="badge"><svg viewBox="0 0 24 24" fill="#17153A"><path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z"/></svg></span>
                <div><div class="title">Add a new app</div><div class="sub">Start with the address and change anything it suggests.</div></div>
              </div>
              <div class="label">Where is it?</div>
              <div class="row">
                <div class="input"><span class="txt">poki.com</span><span class="cur"></span></div>
                <div class="btn-go">Check</div>
              </div>
              <div class="probe" hidden><div class="probe-bar"><span class="probe-fill"></span></div><p class="probe-step"></p></div>
              <div class="found" hidden><p></p><div class="slot"></div></div>
              <div class="foot"><span class="ghost">Cancel</span><span class="save">Save</span></div>
            </div>
          </div>
        </div>
      </div>

      <div class="pills reveal">
        <span>Ads filtered</span><span>No account</span><span>No tracking</span><span>Nothing uploaded</span><span>Never updates by itself</span>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">You decide when</span>
        <h2>Play time that ends by itself</h2>
        <p>Set it once. Every time the app opens, the clock starts again.</p>
      </div>

      <div class="timer reveal d1">
        <div class="dial" aria-hidden="true">
          <svg viewBox="0 0 132 132">
            <circle class="dial-track" cx="66" cy="66" r="58"/>
            <circle class="dial-prog" cx="66" cy="66" r="58"/>
          </svg>
          <div class="dial-face"><b id="dial-time">20:00</b><span id="dial-word">left</span></div>
        </div>

        <div class="timer-copy">
          <div class="chips" aria-hidden="true">
            <span>Off</span><span>10 min</span><span>15 min</span>
            <span class="on">20 min</span><span>30 min</span><span>1 hour</span>
          </div>
          <ul class="ticks">
            <li><span class="tick yes">&check;</span><span><b>Hand it over and walk away.</b> No negotiating, no watching the clock yourself.</span></li>
            <li><span class="tick yes">&check;</span><span><b>The countdown only appears at the end.</b> A clock on screen all afternoon is a thing to watch, and then a thing to argue about.</span></li>
            <li><span class="tick yes">&check;</span><span><b>Then it stops.</b> A gentle screen, and nothing else opens until you hold the button.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--violet">
    <div class="gate">
      <div class="reveal" style="padding-inline:24px">
        <span class="kicker">For grown-ups only</span>
        <h2>Little fingers tap.<br>Grown-ups hold.</h2>
        <ul class="points">
          <li><span class="ic"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="#3B6BFF" stroke-width="2.6"/><path d="M12 7v5l3.5 2" stroke="#17153A" stroke-width="2.6" stroke-linecap="round"/></svg></span>Closing needs a steady three-second hold</li>
          <li><span class="ic"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="7" width="18" height="11" rx="3" fill="#8B5CF6"/><circle cx="8" cy="12.5" r="1.4" fill="#fff"/><circle cx="12" cy="12.5" r="1.4" fill="#fff"/><circle cx="16" cy="12.5" r="1.4" fill="#fff"/></svg></span>Add a PIN for older, cleverer siblings</li>
          <li><span class="ic"><svg viewBox="0 0 24 24" fill="none"><path d="M4 20c0-3.3 3.6-6 8-6s8 2.7 8 6" stroke="#17153A" stroke-width="2.6" stroke-linecap="round"/><circle cx="12" cy="8" r="4" fill="#FFBE18"/></svg></span>The same hold opens your settings</li>
        </ul>
      </div>
      <div class="reveal d1" style="padding-inline:24px">
        <div class="gate-card">
          <img src="/assets/cutout-proud.png" alt="" width="70" height="70" loading="lazy">
          <div class="t">Grown-ups only</div>
          <p class="h" aria-live="polite">Press and hold for 3 seconds.</p>
          <button class="hold" type="button" aria-label="Press and hold for three seconds"><span class="ring"></span><span class="fill"></span><span class="lbl">Hold</span></button>
          <p class="try">Try it, right here</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">No surprises</span>
        <h2>Know before you hand it over</h2>
        <p>Each system decides what an app is allowed to hold. Here is where they draw the line.</p>
      </div>

      <div class="limits">
        <div class="limit reveal">
          <header><svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="7" y="7" width="15" height="15" rx="2.5" fill="#3B6BFF"/>
  <rect x="26" y="7" width="15" height="15" rx="2.5" fill="#17153A" opacity=".82"/>
  <rect x="7" y="26" width="15" height="15" rx="2.5" fill="#17153A" opacity=".82"/>
  <rect x="26" y="26" width="15" height="15" rx="2.5" fill="#3B6BFF"/>
</svg><b>Windows</b></header>
          <ul>
            <li><span class="tick warn">!</span><span><b>The Windows key still opens Start</b>Windows lets no app hold that key, so Sukhi Play closes the menu the moment it appears. You see a flash, nothing more.</span></li>
            <li><span class="tick yes">&check;</span><span><b>Everything else holds</b>Taskbar, Alt+Tab, Alt+F4, Print Screen.</span></li>
          </ul>
          <a class="more" href="/windows/">Windows details &rarr;</a>
        </div>
        <div class="limit reveal d1">
          <header><svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <path d="M24 5c6 0 9 4.4 9 10v7c0 3 1.6 5 3.6 7.6 2.3 3 3.4 5.2 3.4 7.4 0 3.4-3 5-7 5-2.6 0-4-.7-5.2-1.4-1.2-.7-2.3-1.2-3.8-1.2s-2.6.5-3.8 1.2C19 41.3 17.6 42 15 42c-4 0-7-1.6-7-5 0-2.2 1.1-4.4 3.4-7.4C13.4 27 15 25 15 22v-7c0-5.6 3-10 9-10z" fill="#17153A"/>
  <ellipse cx="24" cy="30" rx="7.5" ry="9.5" fill="#FFF7EC"/>
  <circle cx="20.6" cy="15.5" r="2.6" fill="#fff"/><circle cx="27.4" cy="15.5" r="2.6" fill="#fff"/>
  <circle cx="20.9" cy="16" r="1.3" fill="#17153A"/><circle cx="27.1" cy="16" r="1.3" fill="#17153A"/>
  <path d="M24 18.4c1.9 0 3.2 1 3.2 2.1S25.9 22.8 24 22.8s-3.2-1.2-3.2-2.3 1.3-2.1 3.2-2.1z" fill="#FFBE18"/>
</svg><b>Linux</b></header>
          <ul>
            <li><span class="tick warn">!</span><span><b>Wayland sessions keep some keys</b>No app can hold keys there. Alt+Tab and Super are still switched off on GNOME.</span></li>
            <li><span class="tick warn">!</span><span><b>The Snap can&rsquo;t touch desktop shortcuts</b>Want Alt+Tab locked too? Use the .deb or AppImage.</span></li>
          </ul>
          <a class="more" href="/linux/">Linux details &rarr;</a>
        </div>
        <div class="limit limit--all reveal d2">
          <header><svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
  <rect x="6" y="9" width="36" height="35" rx="10" fill="#17153A"/>
  <rect x="6" y="4.5" width="36" height="35" rx="10" fill="#fff" stroke="#17153A" stroke-width="3"/>
  <path transform="translate(12 10) " d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3" stroke="#3B6BFF" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/>
</svg><b>On a Mac, everything locks.</b></header>
          <div class="oks"><span>Menu bar</span><span>Dock</span><span>Cmd+Tab</span><span>Screenshots</span></div>
          <a class="more" href="/macos/">macOS details &rarr;</a>
        </div>
      </div>

      <p class="fineprint reveal">Force Quit is never blocked, on any system, so you can always get back in.
        Sukhi Play is one layer for a toddler, not a babysitter. Stay close by.</p>
    </div>
  </section>

  <!-- The launch of Sukhi Colouring. Near the end on purpose: this page is
       about Sukhi Play first, and the colouring book is news for somebody who
       has already read that far. The download stays the very last thing. -->
  <section class="news">
    <div class="wrap">
      <div class="news-card reveal">
        <div class="news-say">
          <span class="news-new">New</span>
          <div class="news-name">
            <img src="/assets/playground-colouring.png" alt="" width="64" height="64" loading="lazy">
            <h2>Introducing Sukhi&nbsp;Colouring</h2>
          </div>
          <p>Our first app made just for little ones. Pick a picture, colour it in.</p>
          <p class="news-facts">Free &middot; No sign-up &middot; Built into Sukhi Play</p>
          <p class="news-go">
            <a class="go" href="/playground/colouring/" target="_blank" rel="noopener">Open the app</a>
            <a class="go go--ghost" href="/colouring/">Read more</a>
          </p>
        </div>
        <a class="news-shot" href="/colouring/" tabindex="-1" aria-hidden="true">
          <img src="/screenshots/colouring/01-a-page-in-progress.png" alt="" width="1240" height="800" loading="lazy" decoding="async">
          <span class="news-dots">
            <i style="--c:#FF5C5C;--i:0"></i><i style="--c:#FFBE18;--i:1"></i><i style="--c:#8BD64B;--i:2"></i><i style="--c:#3B6BFF;--i:3"></i><i style="--c:#8B5CF6;--i:4"></i>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section style="padding-top:24px">
    <div class="wrap">
      <div class="section-head reveal">
        <h2>Ready when you are</h2>
        <p>Free for every family, on every computer.</p>
      </div>
      <div class="os reveal">
