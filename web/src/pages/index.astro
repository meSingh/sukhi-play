<script is:inline>
/* Reveal on scroll, and mark the visitor's own platform. Both are decoration:
   without this script every section is visible and every link works. */
(function () {
  var root = document.documentElement;
  var ua = navigator.userAgent;
  var plat = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.platform || '';
  var touch = navigator.maxTouchPoints > 1;
  var os = /Android|iPhone|iPad/i.test(ua) ? null
    : /Mac/i.test(plat + ua) && !touch ? 'mac'
    : /Win/i.test(plat + ua) ? 'win'
    : /Linux|X11|CrOS/i.test(plat + ua) ? 'linux' : null;
  window.SUKHI_OS = os;

  // Phone menu: the nav slides in from the side instead of wrapping.
  var menuBtn = document.querySelector('.menu-btn');
  var scrim = document.querySelector('.nav-scrim');
  var setMenu = function (open) {
    root.classList.toggle('nav-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    scrim.hidden = !open;
    if (open) document.getElementById('site-nav').focus({ preventScroll: true });
  };
  if (menuBtn) {
    menuBtn.addEventListener('click', function () { setMenu(true); });
    document.querySelector('.menu-close').addEventListener('click', function () { setMenu(false); menuBtn.focus(); });
    scrim.addEventListener('click', function () { setMenu(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && root.classList.contains('nav-open')) { setMenu(false); menuBtn.focus(); } });
    window.matchMedia('(min-width: 621px)').addEventListener('change', function (m) { if (m.matches) setMenu(false); });
  }
  if (os) {
    document.querySelectorAll('[data-os="' + os + '"]').forEach(function (el) {
      el.classList.add('yours');
      var tag = el.querySelector('.yours[hidden]');
      if (tag) tag.hidden = false;
    });
  }

  var els = document.querySelectorAll('.reveal, .vault');
  if (!('IntersectionObserver' in window) ||
      window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  // Only now hide them, so nothing can leave the page blank.
  root.classList.add('js');
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { rootMargin: '0px 0px -8% 0px' });
  els.forEach(function (el) { io.observe(el); });
})();
</script>

<script is:inline>
(function () {

  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function wait(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }

  /* ---------- the headline: a different worry every visit ---------- */
  var HEADLINES = [["Hand over the laptop.", "Keep your work."], ["Let them press every key.", "Nothing happens."], ["Your inbox stays shut.", "No surprise emails."], ["No wandering off.", "Only the sites you picked."], ["Tiny hands can’t close it.", "Only you can."], ["Not one file deleted.", "Not one tab closed."], ["Popups can’t open.", "Ads get filtered out."], ["No accidental downloads.", "No mystery installs."], ["No sneaky YouTube detours.", "Unless you said so."], ["Screen time,", "without the cleanup after."]];
  var live = document.querySelector('.rotator .live');
  if (live) {
    var l1 = live.querySelector('.l1'), l2 = live.querySelector('.l2');
    var at = Math.floor(Math.random() * HEADLINES.length);

    // Each word is its own element so it can rise in, and fall away, a beat
    // after the one before it.
    var words = function (el, text, from) {
      el.textContent = '';
      text.split(' ').forEach(function (w, i) {
        if (i) el.appendChild(document.createTextNode(' '));
        var span = document.createElement('span');
        span.className = 'w';
        span.style.setProperty('--i', from + i);
        span.textContent = w;
        el.appendChild(span);
      });
      return from + text.split(' ').length;
    };
    var show = function (pair) { words(l2, pair[1], words(l1, pair[0], 0)); };
    show(HEADLINES[at]);

    if (!reduced) (async function () {
      for (;;) {
        await wait(2600);
        if (document.hidden) continue;
        live.classList.add('out');
        await wait(520);
        at = (at + 1) % HEADLINES.length;
        live.classList.add('pre');
        live.classList.remove('out');
        show(HEADLINES[at]);
        live.offsetWidth;
        live.classList.remove('pre');
        await wait(900);
      }
    })();
  }

  /* ---------- set up in a minute: the whole flow, on a loop ---------- */
  var SITES = [{"addr": "poki.com", "name": "Poki", "color": "#2F48B8", "icon": "rocket", "hosts": 5, "ads": 9}, {"addr": "pbskids.org", "name": "PBS Kids", "color": "#4DB384", "icon": "star", "hosts": 7, "ads": 14}, {"addr": "scratch.mit.edu", "name": "Scratch", "color": "#E9A23B", "icon": "blocks", "hosts": 4, "ads": 0}];
  var ICONS = {"rocket": "<g transform=\"scale(.24)\"><path d=\"M50 6c14 14 20 30 20 46v12H30V52c0-16 6-32 20-46Z\"/><path d=\"M30 56 14 74l14-2 4 12Z\"/><path d=\"M70 56l16 18-14-2-4 12Z\"/><circle cx=\"50\" cy=\"44\" r=\"9\" fill=\"rgba(0,0,0,.3)\"/></g>", "star": "<path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z\"/>", "blocks": "<rect x=\"8.8\" y=\"3\" width=\"6.6\" height=\"6.6\" rx=\"1.3\"/><rect x=\"4.4\" y=\"11.4\" width=\"6.6\" height=\"6.6\" rx=\"1.3\"/><rect x=\"13\" y=\"11.4\" width=\"6.6\" height=\"6.6\" rx=\"1.3\"/>"};
  var stage = document.querySelector('.stage');
  if (stage) {
    var tabs = [].slice.call(document.querySelectorAll('.tour-steps button'));
    var txt = stage.querySelector('.txt'), input = stage.querySelector('.input');
    var go = stage.querySelector('.btn-go'), save = stage.querySelector('.save');
    var probe = stage.querySelector('.probe'), fillBar = stage.querySelector('.probe-fill');
    var stepText = stage.querySelector('.probe-step');
    var found = stage.querySelector('.found'), grid = stage.querySelector('.launch .grid');
    var run = 0, site = 0, added = [];

    var tile = function (s, isNew) {
      return '<div class="tile' + (isNew ? ' new' : '') + '" style="background:' + s.color + '"><span class="face">' +
        '<svg viewBox="0 0 24 24" fill="' + s.color + '">' + ICONS[s.icon] + '</svg></span>' + s.name + '</div>';
    };
    var step = function (n, ms) {
      tabs.forEach(function (b, i) {
        var bar = b.querySelector('.bar i');
        b.classList.toggle('on', i === n);
        b.classList.toggle('done', i < n);
        bar.style.transition = 'none';
        bar.style.width = i < n ? '100%' : '0%';
        if (i === n && ms) {
          bar.offsetWidth;
          bar.style.transition = 'width ' + ms + 'ms linear';
          bar.style.width = '100%';
        }
      });
    };
    var press = async function (el, token) { el.classList.add('pressed'); await pause(170, token); el.classList.remove('pressed'); };
    var pause = function (ms, token) {
      return wait(ms).then(function () { if (token !== run) throw 'stale'; });
    };

    var play = async function (from) {
      var token = ++run;
      try {
        for (;;) {
          var s = SITES[site];
          // 1. type the address
          if (from <= 0) {
            stage.classList.remove('show-launch');
            probe.hidden = true; found.hidden = true; save.classList.remove('ready');
            txt.textContent = ''; input.classList.add('focus');
            step(0, 900 + s.addr.length * 95 + 700);
            await pause(700, token);
            for (var i = 1; i <= s.addr.length; i++) { txt.textContent = s.addr.slice(0, i); await pause(95, token); }
            await pause(500, token);
            await press(go, token);
          }
          // 2. it checks the site and fills everything in
          if (from <= 1) {
            stage.classList.remove('show-launch');
            txt.textContent = s.addr; input.classList.remove('focus');
            found.hidden = true; save.classList.remove('ready');
            step(1, 6200);
            probe.hidden = false;
            fillBar.style.transition = 'none'; fillBar.style.width = '0%'; fillBar.offsetWidth;
            fillBar.style.transition = 'width 3400ms linear'; fillBar.style.width = '100%';
            var msgs = [[0, 'Opening the page\u2026'], [750, 'Watching what it loads\u2026'], [1600, 'Sorting the adverts from the rest\u2026'], [900, 'Working out what it needs\u2026']];
            for (var m = 0; m < msgs.length; m++) { await pause(msgs[m][0], token); stepText.textContent = msgs[m][1]; }
            await pause(250, token);
            probe.hidden = true;
            found.querySelector('p').textContent = 'Needs ' + s.hosts + ' hosts. ' +
              (s.ads ? s.ads + ' looked like advertising or tracking and will be blocked.' : 'Nothing looked like advertising.');
            found.querySelector('.slot').innerHTML = tile(s, true);
            found.hidden = false;
            await pause(1500, token);
            save.classList.add('ready');
            await pause(500, token);
            await press(save, token);
          }
          // 3. it is on the child's screen
          step(2, 3600);
          if (added.indexOf(site) < 0) added.push(site);
          grid.innerHTML = added.map(function (i) { return tile(SITES[i], i === site); }).join('');
          stage.classList.add('show-launch');
          await pause(3600, token);

          site = (site + 1) % SITES.length;
          if (site === 0) added = [];
          from = 0;
        }
      } catch (e) { if (e !== 'stale') throw e; }
    };

    tabs.forEach(function (b) {
      b.addEventListener('click', function () { play(+b.dataset.step); });
    });

    if (!reduced && 'IntersectionObserver' in window) {
      var seen = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) { seen.disconnect(); play(0); }
      }, { threshold: .35 });
      seen.observe(stage);
    }
  }

  /* ---------- the play time dial ---------- */
  // A whole session in ten seconds: the ring empties, the clock counts down,
  // and it ends the way it ends in the app. Decoration, so without the script
  // the dial simply reads 20:00.
  var dial = document.querySelector('.dial');
  if (dial && !reduced) {
    var ring = dial.querySelector('.dial-prog');
    var time = document.getElementById('dial-time');
    var word = document.getElementById('dial-word');
    var LENGTH = 365;
    var runDial = async function () {
      for (;;) {
        dial.classList.remove('is-up');
        word.textContent = 'left';
        for (var step = 0; step <= 40; step++) {
          var part = step / 40;
          var secs = Math.round(20 * 60 * (1 - part));
          ring.style.strokeDashoffset = (LENGTH * part).toFixed(1);
          time.textContent = Math.floor(secs / 60) + ':' + String(secs % 60).padStart(2, '0');
          await wait(220);
        }
        dial.classList.add('is-up');
        time.textContent = 'That is all';
        word.textContent = 'for now';
        await wait(2600);
        ring.style.strokeDashoffset = '0';
        await wait(500);
      }
    };
    var started = false;
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting && !started) { started = true; runDial(); }
      }, { threshold: .4 }).observe(dial);
    } else { runDial(); }
  }

  /* ---------- hold to get out: the real thing, to try ---------- */
  var card = document.querySelector('.gate-card');
  if (card) {
    var btn = card.querySelector('.hold'), fill = btn.querySelector('.fill');
    var title = card.querySelector('.t'), hint = card.querySelector('.h');
    var HOLD = 3000, level = 0, raf = 0, started = 0, holding = false, unlocked = false, demo = true, demoTimer = 0;
    var HINT = hint.textContent;

    var set = function (p) { level = p; fill.style.height = (p * 100) + '%'; btn.classList.toggle('full', p > .55); };
    var drain = function () {
      var from = level, t0 = performance.now();
      cancelAnimationFrame(raf);
      (function d(now) {
        var p = Math.max(0, from - (now - t0) / 450);
        set(p);
        if (p > 0) raf = requestAnimationFrame(d);
      })(t0);
    };
    var tick = function (now) {
      var p = Math.min(1, (now - started) / HOLD);
      set(p);
      if (p >= 1) return unlock();
      raf = requestAnimationFrame(tick);
    };
    var unlock = function () {
      holding = false; unlocked = true;
      card.classList.add('unlocked');
      title.textContent = 'You\u2019re in';
      hint.textContent = 'Three whole seconds. Toddlers let go long before that.';
      setTimeout(function () {
        unlocked = false; card.classList.remove('unlocked');
        title.textContent = 'Grown-ups only'; hint.textContent = HINT; set(0);
      }, 2800);
    };
    var down = function (e) {
      if (unlocked || holding) return;
      if (e && e.preventDefault) e.preventDefault();
      demo = false; clearTimeout(demoTimer);
      holding = true;
      cancelAnimationFrame(raf);
      started = performance.now() - level * HOLD;
      hint.textContent = 'Keep holding\u2026';
      raf = requestAnimationFrame(tick);
    };
    var up = function () {
      if (!holding) return;
      holding = false;
      if (level < 1) { hint.textContent = 'Let go too soon. That\u2019s the point.'; drain(); }
    };
    btn.addEventListener('pointerdown', down);
    ['pointerup', 'pointerleave', 'pointercancel'].forEach(function (t) { btn.addEventListener(t, up); });
    btn.addEventListener('contextmenu', function (e) { e.preventDefault(); });
    btn.addEventListener('keydown', function (e) { if ((e.key === ' ' || e.key === 'Enter') && !e.repeat) down(e); });
    btn.addEventListener('keyup', function (e) { if (e.key === ' ' || e.key === 'Enter') up(); });

    // Until someone tries it: a small child's quick taps, doing nothing.
    var tap = function () {
      if (!demo) return;
      btn.classList.remove('tap'); btn.offsetWidth; btn.classList.add('tap');
      set(.09); drain();
      hint.textContent = 'A quick tap does nothing.';
      demoTimer = setTimeout(tap, 900 + Math.random() * 1600);
    };
    if (!reduced && 'IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        clearTimeout(demoTimer);
        if (entries[0].isIntersecting && demo) demoTimer = setTimeout(tap, 800);
      }, { threshold: .5 }).observe(btn);
    }
  }
})();
</script>
