---
/**
 * Sukhi Colouring's own page.
 *
 * Built the way the front page is built, and for the same reason: this is a
 * thing you look at, so the page should be too. Bands of colour, one idea per
 * screen, the screenshots doing the explaining, and as few words as each one
 * can be made to carry. An earlier version of this page was three paragraphs
 * per section and read like documentation for something nobody had seen yet.
 *
 * Written for a parent, not for a developer. Every heading says what their
 * child can do or what they can stop worrying about, in words that need no
 * explaining: "Pick up where they left off", not "Keeps the page, not a
 * picture of it".
 *
 * "Where it came from" is one quiet card: this is derived from the original
 * work it names, and thank you. It is set apart by its frame rather than by
 * shouting, and says nothing else.
 *
 * Links that leave this page -- into the app, or out to the original project --
 * open in a new tab, so the page is still there to come back to.
 *
 * Every screenshot is the real application, driven into that state and
 * captured by scripts/colouring-shots.js. Nothing here is a mock-up.
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const APP = '/playground/colouring/';

/** The app's own palette, used as the page's confetti. */
const PALETTE = ['#FF5C5C', '#FF8A3D', '#FFBE18', '#8BD64B', '#10D6A0',
                 '#2FB8C8', '#3B6BFF', '#7BB6FF', '#8B5CF6', '#D96FD6'];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Sukhi Colouring',
  url: new URL(APP, SITE).href,
  description: 'A colouring book for small children. Forty pictures, three pens, fill, a mirror and a shelf that keeps their work. Free, no account, works offline.',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires a modern browser. Works offline once opened.',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  inLanguage: ['en', 'ko'],
  screenshot: [
    new URL('/screenshots/colouring/01-a-page-in-progress.png', SITE).href,
    new URL('/screenshots/colouring/02-forty-pictures.png', SITE).href,
    new URL('/screenshots/colouring/03-the-shelf.png', SITE).href
  ],
  isPartOf: { '@type': 'SoftwareApplication', name: 'Sukhi Play', url: SITE }
};
---

<Base
  title="Sukhi Colouring, a colouring book for small children"
  description="Forty pictures, three fun pens, tap-to-fill and a place to save their work. Free, no sign-up, and it works without internet."
  page="colouring"
  image="/screenshots/colouring/01-a-page-in-progress.png"
  schema={schema}>

  <div class="wrap">
    <div class="hero co-hero">
      <img class="co-mark bob" src="/assets/playground-colouring.png" alt="" width="112" height="112">
      <h1>Sukhi&nbsp;Colouring</h1>
      <p class="lede">Pick a picture. Colour it in.</p>

      <p class="co-dots" aria-hidden="true">
        {PALETTE.map((hex, i) => (
          <span style={`--c:${hex};--i:${i}`}></span>
        ))}
      </p>

      <p class="co-go">
        <a class="go go--big" href={APP} target="_blank" rel="noopener">Start colouring</a>
      </p>
      <p class="note-small">Free &middot; No sign-up &middot; Works without internet</p>
    </div>

    <div class="device co-device reveal">
      <img src="/screenshots/colouring/01-a-page-in-progress.png"
           alt="A tortoise picture with its shell coloured in, colours down the left and the tools down the right"
           width="1240" height="800" fetchpriority="high" decoding="async">
    </div>
    <p class="note-small">What your child will see.</p>
  </div>

  <section class="band" style="margin-top:72px">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">What your child can do</span>
        <h2>Simple enough for little hands</h2>
      </div>

      <ul class="co-kit reveal">
        <li style="--c:#FF5C5C">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 38h5l20-20a3.5 3.5 0 0 0-5-5L10 33z" fill="#FF5C5C"/><path d="M30 13l5 5" stroke="#17153A" stroke-width="2.6" stroke-linecap="round"/><circle cx="12.5" cy="35.5" r="2" fill="#17153A"/></svg></span>
          <b>Pencil, crayon and rainbow</b><small>Three pens, each one looks and sounds different</small>
        </li>
        <li style="--c:#3B6BFF">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M11 24 22 13l12 12a2.6 2.6 0 0 1 0 3.6l-8.4 8.4a2.6 2.6 0 0 1-3.6 0L11 26.6a1.8 1.8 0 0 1 0-2.6z" fill="#3B6BFF"/><path d="M19 10l3 3" stroke="#17153A" stroke-width="2.6" stroke-linecap="round"/><path d="M38 28c2 2.4 3 4 3 5.4a3 3 0 0 1-6 0c0-1.4 1-3 3-5.4z" fill="#10D6A0"/></svg></span>
          <b>Tap to fill</b><small>Colours in a whole shape with one tap</small>
        </li>
        <li style="--c:#D96FD6">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><ellipse cx="15" cy="17" rx="9" ry="7" fill="#FF8FC0"/><ellipse cx="33" cy="17" rx="9" ry="7" fill="#7BB6FF"/><ellipse cx="15" cy="31" rx="8" ry="6.5" fill="#FFBE18"/><ellipse cx="33" cy="31" rx="8" ry="6.5" fill="#8BD64B"/><rect x="22" y="12" width="4" height="24" rx="2" fill="#17153A"/></svg></span>
          <b>Mirror drawing</b><small>Draw on one side and it appears on both</small>
        </li>
        <li style="--c:#FFBE18">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="13" cy="14" r="6" fill="#FF5C5C"/><circle cx="27" cy="14" r="6" fill="#FFBE18"/><circle cx="41" cy="14" r="6" fill="#8BD64B"/><circle cx="13" cy="30" r="6" fill="#10D6A0"/><circle cx="27" cy="30" r="6" fill="#3B6BFF"/><circle cx="41" cy="30" r="6" fill="#8B5CF6"/></svg></span>
          <b>Twenty colours</b><small>Big, bright and always in reach</small>
        </li>
        <li style="--c:#10D6A0">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 26h18a9 9 0 1 1 0 18h-7" fill="none" stroke="#10D6A0" stroke-width="4" stroke-linecap="round"/><path d="m14 19-7 7 7 7" fill="none" stroke="#10D6A0" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="34" cy="14" r="7" fill="#FFBE18"/></svg></span>
          <b>Undo anything</b><small>An oops button for every mistake</small>
        </li>
        <li style="--c:#8B5CF6">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="10" width="36" height="28" rx="5" fill="#fff" stroke="#17153A" stroke-width="2.6"/><path d="M6 31l9-8 7 6 8-9 12 11v3a5 5 0 0 1-5 5H11a5 5 0 0 1-5-5z" fill="#8B5CF6"/><circle cx="17" cy="19" r="3.2" fill="#FFBE18"/></svg></span>
          <b>English and 한국어</b><small>Switch languages in settings</small>
        </li>
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="co-shot reveal">
        <div>
          <span class="kicker">Pictures to colour</span>
          <h2>Forty pictures to choose from</h2>
          <p>Animals, cars, flowers and more. Or start with a blank page.</p>
        </div>
        <img src="/screenshots/colouring/02-forty-pictures.png"
             alt="The picture chooser, a grid of animals, vehicles and other drawings"
             width="1240" height="800" loading="lazy" decoding="async">
      </div>

      <div class="co-shot co-shot--flip reveal">
        <div>
          <span class="kicker">Save their work</span>
          <h2>Pick up where they left off</h2>
          <p>Save a picture and open it again later, exactly as they left it.</p>
        </div>
        <img src="/screenshots/colouring/03-the-shelf.png"
             alt="Three saved pictures, a kite, a car and a tree, each with a download and a delete button"
             width="1240" height="800" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <section class="band band--mint">
    <div class="wrap">
      <div class="co-phone reveal">
        <div>
          <span class="kicker">Phones and tablets</span>
          <h2>Just as good on a small screen</h2>
          <p>Same pictures, same pens, with buttons sized for small fingers.</p>

          <h3 class="co-steps-title">Add it to your home screen</h3>
          <ul class="co-steps">
            <li><b>iPhone and iPad</b> Open it in Safari, tap Share, then Add to Home Screen.</li>
            <li><b>Android</b> Open it in Chrome, tap the menu, then Add to Home screen.</li>
            <li><b>Computer</b> In Chrome or Edge, click the install icon in the address bar.</li>
          </ul>
          <p class="co-steps-after">Or press <b>Add to home screen</b> inside the app for the steps on your device. It then opens like any other app, full screen, even with no internet.</p>
        </div>
        <img src="/screenshots/colouring/04-on-a-phone.png"
             alt="Sukhi Colouring on a phone: tools along the top, the picture in the middle, colours along the bottom"
             width="402" height="844" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">Safe for little ones</span>
        <h2>No sign-ups. No ads. Nothing shared.</h2>
        <p>Hand it over without a second thought.</p>
      </div>

      <ul class="co-safe reveal">
        <li style="--c:#3B6BFF">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="17" r="8" fill="#3B6BFF"/><path d="M9 41c1.5-8 7.5-12 15-12s13.5 4 15 12z" fill="#7BB6FF"/><path d="M8 8l32 32" stroke="#FF5C5C" stroke-width="4" stroke-linecap="round"/></svg></span>
          <b>No account</b><small>No email, no password, nothing to sign up for</small>
        </li>
        <li style="--c:#FF5C5C">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="11" width="36" height="26" rx="5" fill="#FFBE18"/><path d="M15 29l4-11 4 11M16.5 25h5M28 18v11h3a4 4 0 0 0 0-8h-3" fill="none" stroke="#17153A" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 8l32 32" stroke="#FF5C5C" stroke-width="4" stroke-linecap="round"/></svg></span>
          <b>No ads</b><small>No adverts, no pop-ups, nothing to buy</small>
        </li>
        <li style="--c:#10D6A0">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="9" y="7" width="30" height="36" rx="6" fill="#10D6A0"/><rect x="14" y="13" width="20" height="20" rx="3" fill="#fff"/><path d="M19 23l4 4 7-8" fill="none" stroke="#10D6A0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          <b>Stays on your device</b><small>Drawings are saved here and never uploaded</small>
        </li>
        <li style="--c:#8B5CF6">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="17" fill="#8B5CF6"/><path d="M7 24h34M24 7c-5 5-5 29 0 34M24 7c5 5 5 29 0 34" fill="none" stroke="#fff" stroke-width="2.4"/><path d="M8 8l32 32" stroke="#FF5C5C" stroke-width="4" stroke-linecap="round"/></svg></span>
          <b>No way out</b><small>Nothing to tap that leads to another website</small>
        </li>
        <li style="--c:#FFBE18">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 19a23 23 0 0 1 32 0M13.5 25a15 15 0 0 1 21 0M19 31a7 7 0 0 1 10 0" fill="none" stroke="#FFBE18" stroke-width="4" stroke-linecap="round"/><circle cx="24" cy="37" r="3" fill="#17153A"/><path d="M8 8l32 32" stroke="#FF5C5C" stroke-width="4" stroke-linecap="round"/></svg></span>
          <b>Works offline</b><small>Once it has opened, no internet needed</small>
        </li>
        <li style="--c:#D96FD6">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="17" fill="#D96FD6"/><text x="24" y="31" text-anchor="middle" font-size="20" font-weight="900" fill="#fff" font-family="system-ui, sans-serif">0</text></svg></span>
          <b>Completely free</b><small>No trial, no subscription, no catch</small>
        </li>
      </ul>
    </div>
  </section>

  <section class="co-from">
    <div class="wrap wrap--narrow">
      <div class="co-from-card reveal">
        <span class="kicker">Where it came from</span>
        <p>
          Derived from the original work of
          <a href="https://github.com/oh-namgyu/kids-coloring" target="_blank" rel="noopener noreferrer">Kids&nbsp;Coloring by oh&#8209;namgyu</a>.
          <span class="co-thanks">Thank you <span aria-hidden="true">🙏</span></span>
        </p>
      </div>
    </div>
  </section>

</Base>

<script is:inline>
  // Same reveal the front page uses. Nothing is hidden until this runs, so a
  // browser without it, or a visitor who asked for less motion, gets the whole
  // page rather than an empty one.
  (function () {
    var root = document.documentElement;
    var els = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('js');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>
