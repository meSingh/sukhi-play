---
/**
 * Sukhi Colouring's own page.
 *
 * Built the way the front page is built, and for the same reason: this is a
 * thing you look at, so the page should be too. Bands of colour, one idea per
 * screen, the screenshots doing the explaining, and as few words as each one
 * can be made to carry. An earlier version of this page was three paragraphs
 * per section and read like documentation for something nobody had seen yet.
 *
 * "Where it came from" is the exception and is meant to be: it is set on ink
 * rather than on a wash, because a credit that looks like every other section
 * reads like small print, and this one is the whole reason the app exists.
 *
 * Every screenshot is the real application, driven into that state and
 * captured by scripts/colouring-shots.js. Nothing here is a mock-up.
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const APP = '/playground/colouring/';

/** The app's own palette, used as the page's confetti. */
const PALETTE = ['#FF5C5C', '#FF8A3D', '#FFBE18', '#8BD64B', '#10D6A0',
                 '#2FB8C8', '#3B6BFF', '#7BB6FF', '#8B5CF6', '#D96FD6'];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Sukhi Colouring',
  url: new URL(APP, SITE).href,
  description: 'A colouring book for small children. Forty pictures, three pens, fill, a mirror and a shelf that keeps their work. Free, no account, works offline.',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Any',
  browserRequirements: 'Requires a modern browser. Works offline once opened.',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  inLanguage: ['en', 'ko'],
  screenshot: [
    new URL('/screenshots/colouring/01-a-page-in-progress.png', SITE).href,
    new URL('/screenshots/colouring/02-forty-pictures.png', SITE).href,
    new URL('/screenshots/colouring/03-the-shelf.png', SITE).href
  ],
  isPartOf: { '@type': 'SoftwareApplication', name: 'Sukhi Play', url: SITE }
};
---

<Base
  title="Sukhi Colouring, a colouring book for small children"
  description="Forty pictures, three pens that feel like different materials, and a shelf that keeps their work. Free, no account, works with no internet."
  page="colouring"
  image="/screenshots/colouring/01-a-page-in-progress.png"
  schema={schema}>

  <div class="wrap">
    <div class="hero co-hero">
      <img class="co-mark bob" src="/assets/playground-colouring.png" alt="" width="112" height="112">
      <h1>Sukhi&nbsp;Colouring</h1>
      <p class="lede">Pick a picture. Colour it in.</p>

      <p class="co-dots" aria-hidden="true">
        {PALETTE.map((hex, i) => (
          <span style={`--c:${hex};--i:${i}`}></span>
        ))}
      </p>

      <p class="co-go">
        <a class="go go--big" href={APP}>Open it</a>
      </p>
      <p class="note-small">Free &middot; No account &middot; Works with no internet</p>
    </div>

    <div class="device co-device reveal">
      <img src="/screenshots/colouring/01-a-page-in-progress.png"
           alt="A tortoise outline with its shell coloured in, twenty colours down the left and the tools down the right"
           width="1240" height="800" fetchpriority="high" decoding="async">
    </div>
    <p class="note-small">The real app. Nothing here is a mock-up.</p>
  </div>

  <!-- What is in it: art, not paragraphs. -->
  <section class="band" style="margin-top:72px">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">What is in it</span>
        <h2>Everything a small hand needs, and nothing else</h2>
      </div>

      <ul class="co-kit reveal">
        <li style="--c:#FF5C5C">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M10 38h5l20-20a3.5 3.5 0 0 0-5-5L10 33z" fill="#FF5C5C"/><path d="M30 13l5 5" stroke="#17153A" stroke-width="2.6" stroke-linecap="round"/><circle cx="12.5" cy="35.5" r="2" fill="#17153A"/></svg></span>
          <b>Three pens</b><small>A pencil, a crayon that skips, a rainbow</small>
        </li>
        <li style="--c:#3B6BFF">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M11 24 22 13l12 12a2.6 2.6 0 0 1 0 3.6l-8.4 8.4a2.6 2.6 0 0 1-3.6 0L11 26.6a1.8 1.8 0 0 1 0-2.6z" fill="#3B6BFF"/><path d="M19 10l3 3" stroke="#17153A" stroke-width="2.6" stroke-linecap="round"/><path d="M38 28c2 2.4 3 4 3 5.4a3 3 0 0 1-6 0c0-1.4 1-3 3-5.4z" fill="#10D6A0"/></svg></span>
          <b>Fill</b><small>Tap inside a shape, it fills to the lines</small>
        </li>
        <li style="--c:#D96FD6">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><ellipse cx="15" cy="17" rx="9" ry="7" fill="#FF8FC0"/><ellipse cx="33" cy="17" rx="9" ry="7" fill="#7BB6FF"/><ellipse cx="15" cy="31" rx="8" ry="6.5" fill="#FFBE18"/><ellipse cx="33" cy="31" rx="8" ry="6.5" fill="#8BD64B"/><rect x="22" y="12" width="4" height="24" rx="2" fill="#17153A"/></svg></span>
          <b>A butterfly</b><small>Draw one side, both sides appear</small>
        </li>
        <li style="--c:#FFBE18">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="13" cy="14" r="6" fill="#FF5C5C"/><circle cx="27" cy="14" r="6" fill="#FFBE18"/><circle cx="41" cy="14" r="6" fill="#8BD64B"/><circle cx="13" cy="30" r="6" fill="#10D6A0"/><circle cx="27" cy="30" r="6" fill="#3B6BFF"/><circle cx="41" cy="30" r="6" fill="#8B5CF6"/></svg></span>
          <b>Twenty colours</b><small>All on screen. No picker, no sliders</small>
        </li>
        <li style="--c:#10D6A0">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 26h18a9 9 0 1 1 0 18h-7" fill="none" stroke="#10D6A0" stroke-width="4" stroke-linecap="round"/><path d="m14 19-7 7 7 7" fill="none" stroke="#10D6A0" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="34" cy="14" r="7" fill="#FFBE18"/></svg></span>
          <b>Back, forward, start again</b><small>Nothing a small hand does is permanent</small>
        </li>
        <li style="--c:#8B5CF6">
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="6" y="10" width="36" height="28" rx="5" fill="#fff" stroke="#17153A" stroke-width="2.6"/><path d="M6 31l9-8 7 6 8-9 12 11v3a5 5 0 0 1-5 5H11a5 5 0 0 1-5-5z" fill="#8B5CF6"/><circle cx="17" cy="19" r="3.2" fill="#FFBE18"/></svg></span>
          <b>English and 한국어</b><small>Both complete, picture names included</small>
        </li>
      </ul>
    </div>
  </section>

  <!-- Two screenshots, one line each. -->
  <section>
    <div class="wrap">
      <div class="co-shot reveal">
        <div>
          <span class="kicker">Forty to start from</span>
          <h2>Animals, things that go, the garden, the sky</h2>
          <p>Or close it and draw on a blank page instead.</p>
        </div>
        <img src="/screenshots/colouring/02-forty-pictures.png"
             alt="The picture chooser, a grid of outline drawings grouped by subject"
             width="1240" height="800" loading="lazy" decoding="async">
      </div>

      <div class="co-shot co-shot--flip reveal">
        <div>
          <span class="kicker">A shelf, not a folder</span>
          <h2>Keeps the page, not a picture of it</h2>
          <p>Open one tomorrow and carry on from where they left it.</p>
        </div>
        <img src="/screenshots/colouring/03-the-shelf.png"
             alt="The shelf, showing three kept pictures with a download and a delete button under each"
             width="1240" height="800" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <!-- The phone, on its own colour. -->
  <section class="band band--mint">
    <div class="wrap">
      <div class="co-phone reveal">
        <div>
          <span class="kicker">On a phone</span>
          <h2>The same app, not a smaller one</h2>
          <p>
            Same pictures, same pens, same shelf. Down to 320&nbsp;px, with every
            control a size a small hand can hit.
          </p>
          <p>
            Keep it on the home screen and it opens full screen, with no address
            bar for a small finger to land in, and it keeps working with no
            signal. <a href="/playground/">How to add it &rarr;</a>
          </p>
        </div>
        <img src="/screenshots/colouring/04-on-a-phone.png"
             alt="Sukhi Colouring on a phone: tools along the top, the page in the middle, colours along the bottom"
             width="402" height="844" loading="lazy" decoding="async">
      </div>
    </div>
  </section>

  <!-- What it does not do. Quiet on purpose. -->
  <section>
    <div class="wrap wrap--narrow">
      <div class="section-head reveal">
        <span class="kicker">And that is all it does</span>
        <h2>No account. No adverts. Nothing collected.</h2>
        <p>
          Nothing a child makes leaves their own machine. The shelf lives in the
          browser, and there is no server on the other end of it.
        </p>
      </div>
    </div>
  </section>

  <!--
    The credit. On ink, because it is the reason this exists and a credit that
    looks like every other section reads like small print.
  -->
  <section class="band band--ink co-from">
    <div class="wrap wrap--narrow">
      <div class="reveal">
        <span class="kicker co-from-kicker">Where it came from</span>
        <blockquote class="co-quote">
          <p>
            The idea, the shape of it and the sound it makes come from
            <a href="https://github.com/oh-namgyu/kids-coloring" rel="noopener">Kids
            Coloring by oh-namgyu</a>.
          </p>
          <p class="co-quote-b">None of the code does.</p>
        </blockquote>
        <p class="co-from-say">
          Sukhi Play bundled that app for its first two years. Writing this one
          from nothing is what made a blank page, a shelf, a second language and
          a layout that works on a phone possible at all. MIT licensed, both of
          them, and credited here, in the NOTICE, on the catalogue, and on this
          app&rsquo;s own About screen.
        </p>
      </div>
    </div>
  </section>

  <!-- Out. -->
  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">First of many</span>
        <h2>It is part of the playground</h2>
        <p>
          The first app built for Sukhi Play rather than allowed into it.
          More are coming.
        </p>
        <p class="co-go co-go--end">
          <a class="go go--big" href={APP}>Open Sukhi Colouring</a>
          <a class="co-more" href="/playground/">See the playground &rarr;</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  // Same reveal the front page uses. Nothing is hidden until this runs, so a
  // browser without it, or a visitor who asked for less motion, gets the whole
  // page rather than an empty one.
  (function () {
    var root = document.documentElement;
    var els = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('js');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>
