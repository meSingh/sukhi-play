---
/**
 * The playground: little apps made for Sukhi Play.
 *
 * Built like the colouring page and the front page -- bands, tiles, reveals,
 * and as few words as each part can carry. It has one job per section: show
 * the app that is here, show how to keep it on a home screen, and show that
 * more are on the way.
 *
 * Every app gets two links that say plainly what they do. "Open the app" goes
 * into the app itself, in a new tab so this page is still here afterwards.
 * "Read more" goes to that app's own page on this site.
 *
 * The apps are not built by Astro. Each is a separate project under
 * playground/, built by scripts/playground-app.mjs into
 * web/public/playground/<name>/, which is generated and not committed.
 */
import Base from '../layouts/Base.astro';
import { SITE } from '../site';

const APPS = [
  {
    name: 'Sukhi Colouring',
    say: 'Pick a picture. Colour it in.',
    icon: '/assets/playground-colouring.png',
    shot: '/screenshots/colouring/01-a-page-in-progress.png',
    open: '/playground/colouring/',
    more: '/colouring/'
  }
];

const PALETTE = ['#FF5C5C', '#FFBE18', '#8BD64B', '#10D6A0', '#3B6BFF', '#8B5CF6', '#D96FD6'];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'The Sukhi Play playground',
  url: new URL('/playground/', SITE).href,
  hasPart: APPS.map((a) => ({
    '@type': 'WebApplication',
    name: a.name,
    url: new URL(a.open, SITE).href,
    applicationCategory: 'GameApplication',
    operatingSystem: 'Any',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }
  })),
  isPartOf: { '@type': 'SoftwareApplication', name: 'Sukhi Play', url: SITE }
};
---

<Base
  title="The Sukhi Play playground"
  description="Little apps made for little ones. Free, no sign-up, and they work without internet."
  page="playground"
  schema={schema}>

  <div class="wrap">
    <div class="hero pg-hero">
      <h1>The playground</h1>
      <p class="lede">Little apps, made for little ones.</p>
      <p class="co-dots" aria-hidden="true">
        {PALETTE.map((hex, i) => <span style={`--c:${hex};--i:${i}`}></span>)}
      </p>
      <p class="note-small">Free &middot; No sign-up &middot; Works without internet</p>
    </div>

    {APPS.map((a) => (
      <article class="pg-app reveal">
        <a class="pg-app-shot" href={a.open} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <img src={a.shot} alt="" width="1240" height="800" loading="eager" decoding="async">
        </a>
        <div class="pg-app-say">
          <span class="pg-badge">The first one</span>
          <div class="pg-app-name">
            <img src={a.icon} alt="" width="64" height="64">
            <h2>{a.name}</h2>
          </div>
          <p>{a.say}</p>
          <p class="pg-links">
            <a class="go" href={a.open} target="_blank" rel="noopener">Open the app</a>
            <a class="go go--ghost" href={a.more}>Read more</a>
          </p>
        </div>
      </article>
    ))}
  </div>

  <section class="band band--violet" style="margin-top:72px">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">Keep it handy</span>
        <h2>Add it to your home screen</h2>
        <p>It then opens like any other app, full screen, even with no internet.</p>
      </div>
      <ul class="pg-how reveal">
        <li>
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="13" y="4" width="22" height="40" rx="5" fill="#17153A"/><rect x="16" y="9" width="16" height="28" rx="2" fill="#7BB6FF"/><circle cx="24" cy="40.5" r="1.6" fill="#fff"/></svg></span>
          <b>iPhone and iPad</b>
          <small>Safari &rarr; Share &rarr; Add to Home Screen</small>
        </li>
        <li>
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="13" y="4" width="22" height="40" rx="5" fill="#10D6A0"/><rect x="16" y="8" width="16" height="30" rx="2" fill="#fff"/><rect x="20" y="40" width="8" height="2" rx="1" fill="#fff"/></svg></span>
          <b>Android</b>
          <small>Chrome &rarr; Menu &rarr; Add to Home screen</small>
        </li>
        <li>
          <span class="co-art"><svg viewBox="0 0 48 48" aria-hidden="true"><rect x="5" y="8" width="38" height="26" rx="4" fill="#3B6BFF"/><rect x="9" y="12" width="30" height="18" rx="2" fill="#fff"/><path d="M16 40h16M24 34v6" stroke="#17153A" stroke-width="3" stroke-linecap="round"/></svg></span>
          <b>Computer</b>
          <small>Chrome or Edge &rarr; the install icon in the address bar</small>
        </li>
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head reveal">
        <span class="kicker">On the way</span>
        <h2>More are coming</h2>
      </div>
      <ul class="pg-soon reveal" aria-label="Apps still being made">
        <li style="--c:#FFBE18"><span></span></li>
        <li style="--c:#10D6A0"><span></span></li>
        <li style="--c:#8B5CF6"><span></span></li>
      </ul>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var els = document.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window) ||
        window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.classList.add('js');
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>
