---
/**
 * One worry, and the screen that answers it.
 *
 * The heading is a fear and its relief, the way the homepage does it -- "Not
 * one file deleted. Not one tab closed." An earlier version of this page
 * headed each section with the name of a screen and numbered the parts of it,
 * which explains a product to somebody already sold on it and says nothing at
 * all to a parent deciding whether to hand over their laptop.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** The worry, first line. */
  fear: string;
  /** The relief, second line, set in blue. */
  relief: string;
  shot: ImageMetadata;
  alt: string;
  /** The screenshot on the left instead of the right. */
  flip?: boolean;
  tone?: 'base' | 'ink';
  caption?: string;
}
const { fear, relief, shot, alt, flip = false, tone = 'base', caption } = Astro.props;
---

<section class:list={['worry', `worry--${tone}`, flip && 'worry--flip']}>
  <div class="wrap">
    <div class="worry-in">
      <div class="worry-say">
        <h2>{fear}<br><em>{relief}</em></h2>
        <slot />
      </div>

      <figure class="worry-shot">
        <button type="button" data-full={shot.src} data-alt={alt}
                aria-label={`See this screen full size: ${alt}`}>
          <Image src={shot} alt={alt} widths={[640, 980, 1400]}
                 sizes="(max-width: 980px) 94vw, 640px" loading="lazy" />
          <span class="shot-mag" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
              <path d="M16 16l5 5M11 8v6M8 11h6" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
        </button>
        {caption && <figcaption>{caption}</figcaption>}
      </figure>
    </div>
  </div>
</section>
