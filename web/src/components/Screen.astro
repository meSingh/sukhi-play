---
/**
 * One real screen, large, with numbered pins on the parts worth looking at.
 *
 * The point is that the picture does the explaining. An earlier version of
 * this page put a 1400px screenshot into a 468px tile, which is too small to
 * read, so the words had to carry everything and the picture was decoration.
 * Here the screenshot is the width of the page and each pin has a matching
 * note beside it, so a reader can look rather than be told.
 *
 * Pins are positioned as percentages of the image, so they stay put at every
 * size. They are hidden from screen readers -- the legend says the same thing
 * in order, and a floating number on a picture is noise to anyone not seeing
 * the picture.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Pin {
  /** Percent across and down the image. */
  x: number;
  y: number;
  what: string;
  /** Which side the label sits on, so it never runs off the edge. */
  side?: 'left' | 'right';
}

interface Props {
  title: string;
  lede: string;
  shot: ImageMetadata;
  alt: string;
  pins: Pin[];
  tone?: 'base' | 'ink';
}
const { title, lede, shot, alt, pins, tone = 'base' } = Astro.props;
---

<section class:list={['screen', `screen--${tone}`]}>
  <div class="wrap">
    <header class="screen-head">
      <h2>{title}</h2>
      <p>{lede}</p>
    </header>

    <div class="screen-body">
      <button class="screen-shot" type="button" data-full={shot.src} data-alt={alt}
              aria-label={`Enlarge: ${alt}`}>
        <Image src={shot} alt={alt} widths={[860, 1200, 1400]}
               sizes="(max-width: 980px) 94vw, 860px" loading="lazy" />
        {pins.map((p, i) => (
          <span class:list={['pin', `pin--${p.side ?? 'right'}`]}
                style={`left:${p.x}%; top:${p.y}%`} aria-hidden="true">
            <b>{i + 1}</b><em>{p.what}</em>
          </span>
        ))}
        <span class="screen-zoom" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
            <path d="M16 16l5 5M11 8v6M8 11h6" fill="none" stroke="currentColor"
                  stroke-width="2" stroke-linecap="round"/>
          </svg>
        </span>
      </button>

      <ol class="screen-legend">
        {pins.map((p, i) => (
          <li><b>{i + 1}</b><span>{p.what}</span></li>
        ))}
        <li class="legend-slot"><slot /></li>
      </ol>
    </div>
  </div>
</section>
