---
/**
 * One tile in the features grid.
 *
 * Tiles differ in size and in kind: some hold a screenshot, some a single
 * number, some only a sentence on a colour. That variety is the point. The
 * previous version of this page was six identical bands, which is a list with
 * pictures in it -- everything weighted the same, so nothing stood out and a
 * reader skimmed to the bottom without stopping.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  /** How much of the four-column grid this takes: 1, 2 or 4. */
  span?: 1 | 2 | 4;
  /** Two rows tall, for the ones carrying a screenshot. */
  tall?: boolean;
  /** amber | violet | cyan | mint | ink — the wash behind it. */
  tone?: 'amber' | 'violet' | 'cyan' | 'mint' | 'ink' | 'paper';
  shot?: ImageMetadata;
  alt?: string;
  /** A short, loud thing: "1,284", "3", "0". */
  stat?: string;
  statNote?: string;
}
const { title, span = 1, tall = false, tone = 'paper', shot, alt, stat, statNote } = Astro.props;
---

<article class:list={['bt', `bt--${span}`, tall && 'bt--tall', `tone-${tone}`]}>
  {shot && (
    <button class="bt-shot" type="button" data-full={shot.src} data-alt={alt}
            aria-label={`Enlarge: ${alt}`}>
      <Image src={shot} alt={alt ?? ''} widths={[460, 720, 1400]}
             sizes="(max-width: 900px) 92vw, 620px" loading="lazy" />
      <span class="bt-zoom" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
          <path d="M16 16l5 5M11 8v6M8 11h6" fill="none" stroke="currentColor"
                stroke-width="2" stroke-linecap="round"/>
        </svg>
      </span>
    </button>
  )}

  {stat && (
    <p class="bt-stat">{stat}{statNote && <span>{statNote}</span>}</p>
  )}

  <div class="bt-say">
    <h3>{title}</h3>
    <slot />
  </div>
</article>
