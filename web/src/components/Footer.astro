---
/**
 * The footer.
 *
 * Six links in one row had become a queue nobody reads to the end of. They
 * are in named columns now, which is more room on the page and less work for
 * a reader: you look at the heading that matches what you want, not at every
 * link in turn.
 */
import { REPO, BLOG_PUBLIC } from '../site';
import { posts } from '../blog';

// Behind the scenes is listed once there is a story in it (and its page is back:
// pages/blog/behind-the-scenes.astro, one line, like the other two).
const hasStories = (await posts()).some((p) => p.data.kind === 'story');

// Every page on the site, one click from any other, in the column a parent
// would look in. The header only has room for the few most asked for; this
// is where the rest live, and where a crawler finds the whole site.
const COLUMNS = [
  {
    name: 'Sukhi Play',
    links: [
      { href: '/', label: 'Overview' },
      { href: '/download/', label: 'Download' },
      { href: '/macos/', label: 'For macOS' },
      { href: '/windows/', label: 'For Windows' },
      { href: '/linux/', label: 'For Linux' },
      { href: '/catalogue/', label: 'Sites that work with it' }
    ]
  },
  {
    name: 'Playground',
    links: [
      { href: '/playground/', label: 'All the apps' },
      { href: '/studio/', label: "Jazz's Studio" },
      { href: '/colouring/', label: 'Sukhi Colouring' },
      { href: '/playground/#experiments', label: "Sukhi's Railway (experiment)" },
      { href: '/playground/#experiments', label: "Sukhi's Run (experiment)" }
    ]
  },
  {
    name: 'Help',
    links: [
      { href: '/docs/', label: 'Documentation' },
      { href: '/docs/installing/', label: 'Installing' },
      { href: '/docs/adding-sites/', label: 'Adding sites' },
      { href: '/docs/play-time/', label: 'Play time' },
      { href: '/faq/', label: 'Questions' },
      { href: '/debug/', label: 'Troubleshooting' },
      { href: '/docs/locked-out/', label: 'Locked out?' }
    ]
  },
  ...(!BLOG_PUBLIC ? [] : [{
    name: 'Blog',
    links: [
      { href: '/blog/', label: 'All posts' },
      { href: '/blog/for-parents/', label: 'For parents' },
      { href: '/blog/announcements/', label: 'Announcements' },
      ...(hasStories ? [{ href: '/blog/behind-the-scenes/', label: 'Behind the scenes' }] : []),
      { href: '/blog/rss.xml', label: 'RSS feed' }
    ]
  }]),
  {
    name: 'About',
    links: [
      { href: '/about/', label: 'Who makes it' },
      { href: REPO, label: 'Source on GitHub' },
      { href: `${REPO}/issues`, label: 'Report a problem' },
      { href: '/licence/', label: 'Licence' },
      { href: '/privacy/', label: 'Privacy' }
    ]
  }
];
import Img from '../components/Img.astro';
---

<section class="madeby">
  <Img class="bob" src="/assets/cutout-proud.png" alt="" width="92" height="92" loading="lazy" sizes="92px" />
  <p class="love">Made with <span class="heart" aria-label="love">&#9829;</span> by
    <a href="https://www.msingh.com">Mandeep Singh</a>,<br>for his cheeky little Sukhraj.</p>
  <p class="story">It began with a three-year-old who pressed every key and clicked
    every button. So Mandeep built a screen where pressing all of them is perfectly safe.</p>
</section>

<footer class="foot">
  <div class="wrap">
    <div class="foot-grid" style={`--cols:${COLUMNS.length}`}>
      <div class="foot-brand">
        <a class="foot-mark" href="/">
          <Img src="/assets/cutout-proud.png" alt="" width="38" height="38" sizes="38px" />Sukhi Play
        </a>
        <p>A locked-down browser that opens only what a grown-up chose.
          Free for every family, with every line of code public, and it asks for nothing.</p>
        <!-- However far down someone scrolls, the download is one press away. -->
        <div class="foot-go">
          <a class="foot-dl" href="/download/"><span>Download</span><small>Free, no account</small></a>
        </div>
      </div>

      {COLUMNS.map((col) => (
        <nav class="foot-col" aria-label={col.name}>
          <h2>{col.name}</h2>
          <ul>
            {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>

    <div class="foot-end">
      <span>&copy; 2026 Mandeep Singh &middot; <a href="/licence/">Free for personal use</a>, Sukhi artwork excluded</span>
      <span class="foot-end-links">
        <a class="foot-gh" href={REPO} aria-label="Sukhi Play on GitHub">
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
          <span>GitHub</span>
        </a>
        <a href="/privacy/" data-consent-reopen data-no-track>Cookie choice</a>
      </span>
    </div>
  </div>
</footer>
