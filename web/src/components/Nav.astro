---
/**
 * The site header: brand, the pages, and the download button.
 *
 * One copy, used by every page. It replaces scripts/build-nav.js, which
 * existed only because this markup used to be pasted into each of eight
 * files and drift between them was invisible until somebody clicked.
 */

interface Props {
  /** The page being rendered, e.g. "docs" — used to mark the current link. */
  page?: string;
}
const { page = '' } = Astro.props;

// The pages in two groups, each a panel under one word, so the bar stays
// short as the site grows: the apps (and the sites the catalogue lists), and
// the help. Blog and GitHub stand on their own. The brand is the way home.
import { BLOG_PUBLIC } from '../site';

const GROUPS = [
  {
    key: 'apps', label: 'Apps',
    current: ['playground', 'studio', 'colouring', 'catalogue'].includes(page),
    items: [
      { href: '/studio/', icon: '/assets/playground-studio.png', name: "Jazz's Studio", note: 'Design and print stationery. Ages 7 and up' },
      { href: '/colouring/', icon: '/assets/playground-colouring.png', name: 'Sukhi Colouring', note: 'Pick a picture and colour it in' },
      { href: '/playground/#experiments', icon: '/assets/playground-railway.png', name: "Sukhi's Railway", note: 'Build a track, press go', chip: 'Experiment' },
      { href: '/playground/#experiments', icon: '/assets/playground-run.png', name: "Sukhi's Run", note: 'Run, get chased, get caught', chip: 'Experiment' },
      { href: '/playground/', glyph: 'grid', name: 'All apps', note: 'Everything in the playground, in any browser' },
      { href: '/catalogue/', glyph: 'globe', name: 'Catalogue', note: 'Websites known to work, ready to switch on' }
    ],
    more: []
  },
  {
    key: 'help', label: 'Help',
    current: ['docs', 'faq', 'debug'].includes(page),
    items: [
      { href: '/docs/', glyph: 'book', name: 'How it all works', note: 'The documentation, start to finish' },
      { href: '/docs/installing/', glyph: 'down', name: 'Installing', note: 'macOS, Windows and Linux' },
      { href: '/faq/', glyph: 'ask', name: 'Questions', note: 'What people ask most, in a paragraph each' },
      { href: '/debug/', glyph: 'fix', name: 'Troubleshooting', note: 'When something is not right' }
    ],
    more: [
      { href: '/docs/locked-out/', label: 'Locked out?' },
      { href: '/docs/limits/', label: 'What it cannot do' }
    ]
  }
];

const GLYPHS: Record<string, string> = {
  book: '<path d="M5 5.5A2.5 2.5 0 0 1 7.5 3H19v15H7.5A2.5 2.5 0 0 0 5 20.5z"/><path d="M5 20.5A2.5 2.5 0 0 0 7.5 23H19v-5"/>',
  down: '<path d="M12 4v11M7 10l5 5 5-5M5 20h14"/>',
  ask: '<circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.4 2.3c-.6.3-.9.8-.9 1.4v.3M12 17h.01"/>',
  grid: '<rect x="4" y="4" width="7" height="7" rx="2"/><rect x="13" y="4" width="7" height="7" rx="2"/><rect x="4" y="13" width="7" height="7" rx="2"/><rect x="13" y="13" width="7" height="7" rx="2"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/>',
  fix: '<path d="M14.5 5.5a4 4 0 0 0 4.9 4.9l-9 9a2 2 0 1 1-2.8-2.8l9-9a4 4 0 0 0-2.1-2.1z"/>'
};

// The platforms hang under the download button rather than sitting in the bar.
// Four of them up front asked a parent to choose before they had a question.
const DOWNLOADS = [
  { href: '/macos/', key: 'macos', label: 'macOS', note: 'Apple Silicon, Intel, older Macs' },
  { href: '/windows/', key: 'windows', label: 'Windows', note: 'Installer or portable' },
  { href: '/linux/', key: 'linux', label: 'Linux', note: 'AppImage, deb, Snap' }
];

const inDownloads = page === 'download' || DOWNLOADS.some((d) => d.key === page);
import Img from '../components/Img.astro';
---

<header class="top">
  <a class="brand" href="/"><Img src="/assets/sukhi-icon.png" alt="" width="38" height="38" sizes="38px" />Sukhi Play</a>

  <button class="menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav">
    <span></span><span></span><span></span>
  </button>

  <nav id="site-nav" tabindex="-1">
    <div class="nav-head">
      <Img src="/assets/sukhi-icon.png" alt="" width="34" height="34" sizes="34px" />Sukhi Play
      <button class="menu-close" type="button" aria-label="Close menu">&times;</button>
    </div>

    {GROUPS.map((g) => (
      <div class:list={['nav-group', g.current && 'is-current']}>
        <button class="nav-group-btn" type="button" aria-expanded="false" aria-controls={`nav-${g.key}`}>
          {g.label}
          <svg class="nav-caret" viewBox="0 0 12 8" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="nav-panel" id={`nav-${g.key}`}>
          <p class="nav-panel-label">{g.label}</p>
          <div class="nav-panel-items">
            {g.items.map((it) => (
              <a class="nav-item" href={it.href}>
                {'icon' in it && it.icon
                  ? <Img src={it.icon} alt="" width="40" height="40" sizes="40px" />
                  : <span class="nav-glyph"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={GLYPHS[(it as { glyph: string }).glyph]} /></span>}
                <span><b>{it.name}{'chip' in it && it.chip && <em>{it.chip}</em>}</b><small>{it.note}</small></span>
              </a>
            ))}
          </div>
          {g.more.length > 0 && <p class="nav-panel-more">{g.more.map((m) => <a href={m.href}>{m.label}</a>)}</p>}
        </div>
      </div>
    ))}

    {BLOG_PUBLIC && <a class="nav-blog" href="/blog/" aria-current={page === 'blog' ? 'page' : undefined}>Blog</a>}

    <!-- Two controls in one pill: a link that goes to the download page,
         because that is what a button marked Download should do, and a caret
         for people who already know which machine they are on. -->
    <div class:list={['nav-dl', inDownloads && 'is-current']}>
      <a class="nav-cta" href="/download/" data-track="Download">
        <span>Download</span>
        <span class="nav-cta-sub">Free, no account</span>
      </a>
      <button class="nav-cta-more" type="button" id="nav-dl-btn"
              aria-expanded="false" aria-controls="nav-dl-menu"
              aria-label="Choose your platform">
        <svg class="nav-caret" viewBox="0 0 12 8" aria-hidden="true">
          <path d="M1 1.5 6 6.5l5-5" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="nav-dl-menu" id="nav-dl-menu">
        {DOWNLOADS.map((d) => (
          <a href={d.href} aria-current={d.key === page ? 'page' : undefined}>
            <b>{d.label}</b><small>{d.note}</small>
          </a>
        ))}
      </div>
    </div>
  </nav>

  <div class="nav-scrim" hidden></div>
</header>

<script>
  // Both menus. This used to live in each page's own script, which meant a new
  // page shipped a hamburger button that did nothing. It belongs with the
  // markup it drives.
  const root = document.documentElement;

  const menuBtn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const scrim = document.querySelector<HTMLElement>('.nav-scrim');
  const closeBtn = document.querySelector<HTMLButtonElement>('.menu-close');

  if (menuBtn && scrim && closeBtn) {
    const setMenu = (on: boolean) => {
      root.classList.toggle('nav-open', on);
      menuBtn.setAttribute('aria-expanded', String(on));
      scrim.hidden = !on;
      if (on) document.getElementById('site-nav')?.focus({ preventScroll: true });
    };
    menuBtn.addEventListener('click', () => setMenu(true));
    closeBtn.addEventListener('click', () => { setMenu(false); menuBtn.focus(); });
    scrim.addEventListener('click', () => setMenu(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('nav-open')) { setMenu(false); menuBtn.focus(); }
    });
    window.matchMedia('(min-width: 621px)').addEventListener('change', (m) => {
      if (m.matches) setMenu(false);
    });
  }

  // The Apps and Help panels. Hover opens them on a desktop (CSS); a click or
  // Enter does the same anywhere, and a click outside or Escape closes them.
  // On a phone they are part of the slide-in list and always open.
  const groups = [...document.querySelectorAll<HTMLElement>('.nav-group')];
  if (groups.length) {
    root.classList.add('has-nav-groups');
    const shut = (except?: HTMLElement) => groups.forEach((g) => {
      if (g === except) return;
      g.classList.remove('is-open');
      g.querySelector('.nav-group-btn')?.setAttribute('aria-expanded', 'false');
    });
    for (const g of groups) {
      const btn = g.querySelector<HTMLButtonElement>('.nav-group-btn')!;
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const on = !g.classList.contains('is-open');
        shut(g);
        g.classList.toggle('is-open', on);
        btn.setAttribute('aria-expanded', String(on));
      });
    }
    document.addEventListener('click', (e) => {
      if (!groups.some((g) => g.contains(e.target as Node))) shut();
    });
    document.addEventListener('keydown', (e) => {
      const open = groups.find((g) => g.classList.contains('is-open'));
      if (e.key === 'Escape' && open) { shut(); open.querySelector<HTMLElement>('.nav-group-btn')?.focus(); }
    });
  }

  const wrap = document.querySelector<HTMLElement>('.nav-dl');
  const caret = document.getElementById('nav-dl-btn');
  if (wrap && caret) {
    // Closed only once there is a script to open it again: without JavaScript
    // the panel stays visible and every link still works.
    root.classList.add('has-nav-dl');
    const open = (on: boolean) => {
      wrap.classList.toggle('is-open', on);
      caret.setAttribute('aria-expanded', String(on));
    };
    caret.addEventListener('click', (e) => {
      e.stopPropagation();
      open(!wrap.classList.contains('is-open'));
    });
    document.addEventListener('click', (e) => {
      if (!wrap.contains(e.target as Node)) open(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && wrap.classList.contains('is-open')) { open(false); caret.focus(); }
    });
  }
</script>
