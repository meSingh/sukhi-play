---
/**
 * One feature: a picture of the thing, and a short account of it.
 *
 * The picture is a real screenshot of the real application, optimised by
 * astro:assets into several widths. The previous version of this page drew
 * little abstractions in CSS, which looked like a diagram of a product rather
 * than the product.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  shot: ImageMetadata;
  alt: string;
  /** Put the picture on the right instead of the left. */
  flip?: boolean;
  note?: string;
}
const { title, shot, alt, flip = false, note } = Astro.props;
---

<article class:list={['feature', flip && 'feature--flip']}>
  <button class="feature-shot" type="button"
          data-full={shot.src} data-alt={alt} aria-label={`Enlarge: ${alt}`}>
    <Image src={shot} alt={alt} widths={[560, 900, 1400]}
           sizes="(max-width: 900px) 92vw, 560px" loading="lazy" />
    <span class="shot-zoom" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
        <path d="M16 16l5 5M11 8v6M8 11h6" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round"/>
      </svg>
    </span>
  </button>
  <div class="feature-say">
    <h2>{title}</h2>
    <slot />
    {note && <p class="feature-note">{note}</p>}
  </div>
</article>
