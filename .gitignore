node_modules/
dist/
.preview/
*.log
.DS_Store
Thumbs.db

# Generated by scripts/make-metainfo.js at build time.
build/linux/*.metainfo.xml

# The Catalina build output.
dist-catalina/
dist-legacy*/

# The Astro site's dependencies. The built output in docs/ is committed.
web/node_modules/
web/.astro/

# Playground apps are their own repositories, mounted here as submodules once
# each one has a remote. Until then they live here untracked, so a `git add -A`
# in this repo cannot swallow a project that is meant to stand on its own.
playground/*/

# The playground apps the site serves are copied here by
# scripts/playground-app.mjs. The published copy is the one in docs/.
web/public/playground/
